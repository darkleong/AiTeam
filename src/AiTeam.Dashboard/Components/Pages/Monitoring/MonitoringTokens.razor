@page "/monitoring/tokens"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Data
@using AiTeam.Shared.Dtos
@using AiTeam.Shared.ViewModels

<PageTitle>Token 統計 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>Token 統計</h2>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done)" : "var(--color-status-failed)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
    </MudStack>
</div>

<div class="page-body">
@* Stage 86 子項 4.1：時間範圍 filter 6 選項 / follow-up #7 v2：OverrideStyles=false 讓 child button 自己控 Variant *@
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.body2" Color="Color.Secondary">時間範圍：</MudText>
    <MudButtonGroup Size="Size.Small" OverrideStyles="false">
        @foreach (var p in _periods)
        {
            <MudButton Variant="@(_selectedPeriod == p.Key ? Variant.Filled : Variant.Outlined)"
                       Color="@(_selectedPeriod == p.Key ? Color.Primary : Color.Default)"
                       OnClick="@(() => SetPeriodAsync(p.Key))">@p.Label</MudButton>
        }
    </MudButtonGroup>
</MudStack>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.body2" Color="Color.Secondary">維度：</MudText>
    <MudSelect T="string" Value="_selectedDimension" ValueChanged="OnDimensionChangedAsync"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:200px">
        <MudSelectItem Value="@("per-Talent")">per-Talent</MudSelectItem>
        <MudSelectItem Value="@("per-PetraSession")">per-PetraSession</MudSelectItem>
        @* Stage 86 子項 4.4：per-Skill 維度 — TokenLog 0 SkillName column / 顯 stub MudAlert *@
        <MudSelectItem Value="@("per-Skill")">per-Skill</MudSelectItem>
    </MudSelect>
    @* Stage 87 follow-up #12：砍「重新載入」button — SignalR ReceiveTokenUpdate 已自動接 Bot 端 push（TokenTrackingProvider.CompleteAsync 結尾 dashboardPush.PushTokenUpdateAsync）*@
</MudStack>

@* 警戒線 alert — 80% 全域月限 / 90% per-agent 日限（Stage 86 子項 4.3）*@
@if (_globalMonthlyLimitK > 0 && _todayTotalKtokens > 0)
{
    var pctMonth = (double)_todayTotalKtokens / _globalMonthlyLimitK * 100;
    if (pctMonth >= 80)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">
            ⚠️ 全域月限警戒：今日已用 @_todayTotalKtokens.ToString("N0") K tokens / 月限 @_globalMonthlyLimitK.ToString("N0") K（@pctMonth.ToString("F1")%）
        </MudAlert>
    }
}
@foreach (var (agentName, pct, total, limitTokens) in GetPerAgentDailyAlerts())
{
    <MudAlert Severity="Severity.Warning" Class="mb-2">
        ⚠️ @agentName 日限警戒：今日已用 @total.ToString("N0") / @limitTokens.ToString("N0")（@pct.ToString("F1")%）
    </MudAlert>
}

@if (_selectedDimension == "per-Talent")
{
    @if (_todaySummary is null || _todaySummary.AgentSummaries.Count == 0)
    {
        <MudAlert Severity="Severity.Info">今日無 Token 使用紀錄。</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-3 mb-3">
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@_perTalentChartSeries"
                      XAxisLabels="@_perTalentXAxisLabels"
                      Width="100%" Height="320px" />
        </MudPaper>

        <MudTable Items="_todaySummary.AgentSummaries" Dense="true" Hover="true" Height="calc(100vh - 100px)" FixedHeader="true" T="TokenAgentSummaryDto"
                  OnRowClick="OnAgentRowClick" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Agent</MudTh>
                <MudTh>Model</MudTh>
                <MudTh Style="text-align:right">Input</MudTh>
                <MudTh Style="text-align:right">Output</MudTh>
                <MudTh Style="text-align:right">Cost (USD)</MudTh>
                <MudTh>Estimated</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AgentName</MudTd>
                <MudTd>@context.Model</MudTd>
                <MudTd Style="text-align:right">@context.TotalInputTokens.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.TotalOutputTokens.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.EstimatedCostUsd.ToString("F4")</MudTd>
                <MudTd>
                    @if (context.HasEstimated)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">est.</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}
else if (_selectedDimension == "per-Skill")
{
    <MudAlert Severity="Severity.Info">
        <strong>per-Skill 維度待 SkillName column 補完才有資料。</strong><br/>
        目前 token_logs 紀錄 AgentName / Stage / PetraSessionId 但無 SkillName 欄位。
        補完後此維度可 GROUP BY SkillName 顯示各 Skill 用量分佈。
    </MudAlert>
}
else if (_selectedDimension == "per-PetraSession")
{
    @if (_perSessionRows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">今日無 PetraSession Token 紀錄。</MudAlert>
    }
    else
    {
        <MudTable Items="_perSessionRows" Dense="true" Hover="true" Height="calc(100vh - 100px)" FixedHeader="true" T="PerSessionRow">
            <HeaderContent>
                <MudTh>PetraSessionId</MudTh>
                <MudTh Style="text-align:right">Row Count</MudTh>
                <MudTh Style="text-align:right">Input</MudTh>
                <MudTh Style="text-align:right">Output</MudTh>
                <MudTh Style="text-align:right">Cost (USD)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PetraSessionId.ToString()[..8]</MudTd>
                <MudTd Style="text-align:right">@context.RowCount</MudTd>
                <MudTd Style="text-align:right">@context.TotalInputTokens.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.TotalOutputTokens.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.TotalCostUsd.ToString("F4")</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@* TokenLogDetail drawer — 點 per-Agent row 開 *@
<MudDrawer @bind-Open="_isTokenDrawerOpen" Anchor="Anchor.End" Elevation="3" Width="500px" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Token 細節（最近 10 筆 / per Agent）</MudText>
    </MudDrawerHeader>
    <div class="pa-4" style="overflow-y:auto">
        @if (_selectedAgentLogs.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">無資料</MudText>
        }
        else
        {
            @foreach (var log in _selectedAgentLogs)
            {
                <MudCard Outlined="true" Class="my-2">
                    <MudCardContent Class="py-2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@log.AgentName</MudChip>
                            <MudText Typo="Typo.caption">@log.Model</MudText>
                            @if (log.IsEstimated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">est.</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.body2">
                            Stage: @(log.Stage ?? "—") · Round: @log.Round
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Input: @log.InputTokens.ToString("N0") · Output: @log.OutputTokens.ToString("N0")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Cache Creation: @((log.CacheCreationTokens ?? 0).ToString("N0")) · Cache Read: @((log.CacheReadTokens ?? 0).ToString("N0"))
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Cost: @(log.TotalCostUsd?.ToString("F6") ?? "—") USD
                        </MudText>
                        @if (log.PetraSessionId.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                PetraSession: @log.PetraSessionId.Value.ToString()[..8]
                            </MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @log.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm:ss")
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
        }
    </div>
</MudDrawer>
</div>
