@page "/monitoring"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Data
@using AiTeam.Shared.Dtos
@using AiTeam.Shared.ViewModels
@using AiTeam.Dashboard.Components.Pages.Home

<PageTitle>監控中心 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>監控中心</h2>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done)" : "var(--color-status-failed)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
    </MudStack>
</div>

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4" Position="Position.Top">

    @* Tab 1：Token Analytics inline MudChart + 維度切換 + 警戒線 + TokenLogDetail drawer *@
    <MudTabPanel Text="Token 統計" Icon="@Icons.Material.Filled.BarChart">
        @* Stage 86 子項 4.1：時間範圍 filter 6 選項 *@
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Color="Color.Secondary">時間範圍：</MudText>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                @foreach (var p in _periods)
                {
                    <MudButton Color="@(_selectedPeriod == p.Key ? Color.Primary : Color.Default)"
                               OnClick="@(() => SetPeriodAsync(p.Key))">@p.Label</MudButton>
                }
            </MudButtonGroup>
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">維度：</MudText>
            <MudSelect T="string" Value="_selectedDimension" ValueChanged="OnDimensionChangedAsync"
                       Variant="Variant.Outlined" Style="max-width:200px">
                <MudSelectItem Value="@("per-Talent")">per-Talent</MudSelectItem>
                <MudSelectItem Value="@("per-PetraSession")">per-PetraSession</MudSelectItem>
                @* Stage 86 子項 4.4：per-Skill 維度 — TokenLog 0 SkillName column / 顯 stub MudAlert *@
                <MudSelectItem Value="@("per-Skill")">per-Skill</MudSelectItem>
            </MudSelect>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadTokensAsync">重新載入</MudButton>
        </MudStack>

        @* 警戒線 alert — 80% 全域月限 / 90% per-agent 日限（Stage 86 子項 4.3 加） *@
        @if (_globalMonthlyLimitK > 0 && _todayTotalKtokens > 0)
        {
            var pctMonth = (double)_todayTotalKtokens / _globalMonthlyLimitK * 100;
            if (pctMonth >= 80)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    ⚠️ 全域月限警戒：今日已用 @_todayTotalKtokens.ToString("N0") K tokens / 月限 @_globalMonthlyLimitK.ToString("N0") K（@pctMonth.ToString("F1")%）
                </MudAlert>
            }
        }
        @* Stage 86 子項 4.3：per-agent 90% 日限警戒（today period 才算） *@
        @foreach (var (agentName, pct, total, limitTokens) in GetPerAgentDailyAlerts())
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                ⚠️ @agentName 日限警戒：今日已用 @total.ToString("N0") / @limitTokens.ToString("N0")（@pct.ToString("F1")%）
            </MudAlert>
        }

        @if (_selectedDimension == "per-Talent")
        {
            @if (_todaySummary is null || _todaySummary.AgentSummaries.Count == 0)
            {
                <MudAlert Severity="Severity.Info">今日無 Token 使用紀錄。</MudAlert>
            }
            else
            {
                @* MudChart inline 趨勢圖（Bar）— per-Agent Input + Output 累計 *@
                <MudPaper Elevation="1" Class="pa-3 mb-3">
                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@_perTalentChartSeries"
                              XAxisLabels="@_perTalentXAxisLabels"
                              Width="100%" Height="320px" />
                </MudPaper>

                <MudTable Items="_todaySummary.AgentSummaries" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="TokenAgentSummaryDto"
                          OnRowClick="OnAgentRowClick" RowClass="cursor-pointer">
                    <HeaderContent>
                        <MudTh>Agent</MudTh>
                        <MudTh>Model</MudTh>
                        <MudTh>Input</MudTh>
                        <MudTh>Output</MudTh>
                        <MudTh>Cost (USD)</MudTh>
                        <MudTh>Estimated</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.AgentName</MudTd>
                        <MudTd>@context.Model</MudTd>
                        <MudTd>@context.TotalInputTokens.ToString("N0")</MudTd>
                        <MudTd>@context.TotalOutputTokens.ToString("N0")</MudTd>
                        <MudTd>@context.EstimatedCostUsd.ToString("F4")</MudTd>
                        <MudTd>
                            @if (context.HasEstimated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">est.</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
        else if (_selectedDimension == "per-Skill")
        {
            @* Stage 86 子項 4.4：TokenLog 0 SkillName column / 待補後才能 GROUP BY SkillName / Stage 86+ FF 候選紀錄 *@
            <MudAlert Severity="Severity.Info">
                <strong>per-Skill 維度待 SkillName column 補完才有資料。</strong><br/>
                目前 token_logs 紀錄 AgentName / Stage / PetraSessionId 但無 SkillName 欄位。
                補完後此維度可 GROUP BY SkillName 顯示各 Skill 用量分佈。
            </MudAlert>
        }
        else if (_selectedDimension == "per-PetraSession")
        {
            @if (_perSessionRows.Count == 0)
            {
                <MudAlert Severity="Severity.Info">今日無 PetraSession Token 紀錄。</MudAlert>
            }
            else
            {
                <MudTable Items="_perSessionRows" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="PerSessionRow">
                    <HeaderContent>
                        <MudTh>PetraSessionId</MudTh>
                        <MudTh>Row Count</MudTh>
                        <MudTh>Input</MudTh>
                        <MudTh>Output</MudTh>
                        <MudTh>Cost (USD)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.PetraSessionId.ToString()[..8]</MudTd>
                        <MudTd>@context.RowCount</MudTd>
                        <MudTd>@context.TotalInputTokens.ToString("N0")</MudTd>
                        <MudTd>@context.TotalOutputTokens.ToString("N0")</MudTd>
                        <MudTd>@context.TotalCostUsd.ToString("F4")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudTabPanel>

    @* Tab 2：Agent Status *@
    <MudTabPanel Text="Agent 狀態" Icon="@Icons.Material.Filled.SmartToy">
        @if (_agentStatuses.Count == 0)
        {
            <MudAlert Severity="Severity.Info">尚未載入 Agent 資料 — 請確認 Bot 啟動。</MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var agent in _agentStatuses)
                {
                    var queueInfo = _agentQueues.FirstOrDefault(q => q.AgentName == agent.AgentName);
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <AgentStatusCard Agent="agent" QueueInfo="queueInfo" />
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    @* Tab 3：Deployments *@
    <MudTabPanel Text="部署紀錄" Icon="@Icons.Material.Filled.RocketLaunch">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            最近 10 筆部署紀錄（TaskItem WHERE AssignedAgent='Ops'）。
        </MudText>
        @if (_recentDeployments.Count == 0)
        {
            <MudAlert Severity="Severity.Info">尚無部署紀錄。</MudAlert>
        }
        else
        {
            <MudTable Items="_recentDeployments" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="TaskItemDto">
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>CreatedAt</MudTh>
                    <MudTh>CompletedAt</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><StatusBadge Status="@context.Status" /></MudTd>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</MudTd>
                    <MudTd>@(context.CompletedAt?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    @* Tab 4：System Health — query /internal/health endpoint *@
    <MudTabPanel Text="系統健康" Icon="@Icons.Material.Filled.HealthAndSafety">
        <MudGrid Spacing="3">
            @* Stage 85 子項 3：Discord placeholder 卡砍（FF #7「Bot /internal/health Discord 真實 check」未實作不該佔位誤導 / 真實 check 做完再加回）*@
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                    <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Large" Color="@(_botHealthy ? Color.Success : Color.Error)" />
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Bot 容器</MudText>
                    <MudText Typo="Typo.body2">@(_botHealthy ? "✅ Healthy" : "❌ Unreachable")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_botStatusDetail</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Large" Color="@(_dbHealthy ? Color.Success : Color.Error)" />
                    <MudText Typo="Typo.subtitle2" Class="mt-2">PostgreSQL</MudText>
                    <MudText Typo="Typo.body2">@(_dbHealthy ? "✅ Connected" : "❌ Disconnected")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_dbStatusDetail</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                    <MudIcon Icon="@Icons.Material.Filled.SignalCellularAlt" Size="Size.Large" Color="@(_hubConnected ? Color.Success : Color.Error)" />
                    <MudText Typo="Typo.subtitle2" Class="mt-2">SignalR Hub</MudText>
                    <MudText Typo="Typo.body2">@(_hubConnected ? "✅ Connected" : "❌ Disconnected")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">/hubs/agent-status</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshHealthAsync">重新檢測（/internal/health）</MudButton>
        </MudStack>
    </MudTabPanel>
</MudTabs>

@* TokenLogDetail drawer — 點 TokenAnalytics row 開 *@
<MudDrawer @bind-Open="_isTokenDrawerOpen" Anchor="Anchor.End" Elevation="3" Width="500px" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Token 細節（最近 10 筆 / per Agent）</MudText>
    </MudDrawerHeader>
    <div class="pa-4" style="overflow-y:auto">
        @if (_selectedAgentLogs.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">無資料</MudText>
        }
        else
        {
            @foreach (var log in _selectedAgentLogs)
            {
                <MudCard Outlined="true" Class="my-2">
                    <MudCardContent Class="py-2">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@log.AgentName</MudChip>
                            <MudText Typo="Typo.caption">@log.Model</MudText>
                            @if (log.IsEstimated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">est.</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.body2">
                            Stage: @(log.Stage ?? "—") · Round: @log.Round
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Input: @log.InputTokens.ToString("N0") · Output: @log.OutputTokens.ToString("N0")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Cache Creation: @((log.CacheCreationTokens ?? 0).ToString("N0")) · Cache Read: @((log.CacheReadTokens ?? 0).ToString("N0"))
                        </MudText>
                        <MudText Typo="Typo.body2">
                            Cost: @(log.TotalCostUsd?.ToString("F6") ?? "—") USD
                        </MudText>
                        @if (log.PetraSessionId.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                PetraSession: @log.PetraSessionId.Value.ToString()[..8]
                            </MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @log.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm:ss")
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
        }
    </div>
</MudDrawer>
