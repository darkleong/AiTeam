@page "/settings"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Data
@using AiTeam.Shared.Dtos
@using AiTeam.Dashboard.Components.Pages.Agents
@using AiTeam.Dashboard.Components.Pages.Projects
@using AiTeam.Dashboard.Components.Pages.Rules
@using AiTeam.Dashboard.Components.Pages.Settings

<PageTitle>設定中心 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>設定中心</h2>
    @if (_pendingRestart)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-0">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-1" Size="Size.Small" />
                Workflow flag 變更後需重啟 Bot 才生效
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="RestartBotAsync" Disabled="@_isRestarting">
                @(_isRestarting ? "重啟中..." : "重啟 Bot")
            </MudButton>
        </MudStack>
    }
</div>

@if (_saveMessage is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-3">@_saveMessage</MudAlert>
}

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4" Position="Position.Top">

    @* Tab 1：Workflow Flags — 議題 C1 完整實裝 *@
    <MudTabPanel Text="Workflow Flags" Icon="@Icons.Material.Filled.ToggleOn">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            21 Workflow:* flag 統一管理。修改後需重啟 Bot 才生效（settings cache 5 分鐘 re-read）。
        </MudText>

        @* Stage 85：v4 Framework 控制（5 flag）panel 整段砍（v4 dead flag / dead UI） *@

        <MudExpansionPanel Text="動態架構（6 flag）" Expanded="true">
            @foreach (var key in _v5Flags)
            {
                <div class="d-flex align-center justify-space-between py-2">
                    <div>
                        <MudText Typo="Typo.body2"><strong>@key</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFlagDescription(key)</MudText>
                    </div>
                    <MudSwitch T="bool" Value="@GetBoolFlag(key)"
                               ValueChanged="@((bool v) => SetBoolFlagAsync(key, v))" Color="Color.Primary" />
                </div>
            }
        </MudExpansionPanel>

        <MudExpansionPanel Text="數值上限（6 flag）" Expanded="false">
            @foreach (var (key, min, max) in _numericFlags)
            {
                @* Stage 86 子項 2.1：數值欄位靠右對齊（justify-end 讓 input 黏右） *@
                <div class="d-flex align-center justify-space-between py-2">
                    <div style="flex:1">
                        <MudText Typo="Typo.body2"><strong>@key</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFlagDescription(key)</MudText>
                    </div>
                    <MudNumericField T="int" Value="@GetIntFlag(key)"
                                     ValueChanged="@((int v) => SetIntFlagAsync(key, v))"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="@min" Max="@max"
                                     Style="max-width:140px; text-align:right" />
                </div>
            }
        </MudExpansionPanel>
    </MudTabPanel>

    @* Tab 2：TokenGuard + 一般系統設定 — reuse 既有 SystemSettings page component（inline 整合 / 對齊 Aria 補做紀律 / 議題 D） *@
    <MudTabPanel Text="Token 守門 + 系統設定" Icon="@Icons.Material.Filled.Shield">
        <SystemSettings />
    </MudTabPanel>

    @* Tab 3：Agents CRUD — reuse 既有 AgentSettings page component（inline 整合） *@
    <MudTabPanel Text="Agents" Icon="@Icons.Material.Filled.SmartToy">
        <AgentSettings />
    </MudTabPanel>

    @* Tab 4：Talents full CRUD — Stage 67 v5.5 Phase 1 Talent + TalentSkill 多對多 *@
    <MudTabPanel Text="Talents" Icon="@Icons.Material.Filled.People">
        <MudStack Row="true" Spacing="2" Class="mb-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _newTalentOpen = !_newTalentOpen)">
                @(_newTalentOpen ? "取消新增" : "新增 Talent")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadTalentsAsync">重新載入</MudButton>
        </MudStack>

        @if (_newTalentOpen)
        {
            <MudPaper Elevation="1" Class="pa-3 mb-3">
                <MudStack Spacing="2">
                    <MudTextField T="string" @bind-Value="_newTalentName" Label="Name（對齊 worker name：Cody / Vera / Quinn / Sage 等）" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_newTalentDisplayName" Label="DisplayName" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_newTalentDescription" Label="Description" Variant="Variant.Outlined" Lines="2" />
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="CreateTalentAsync">建立</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        @if (_talents.Count == 0)
        {
            <MudAlert Severity="Severity.Info">尚無 Talent — 預設 6 instance：Cody / Vera / Quinn / Sage / Petra / Victoria。</MudAlert>
        }
        else
        {
            <MudTable Items="_talents" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="TalentRow">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>DisplayName</MudTh>
                    <MudTh>Provider / Model</MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh>Skills</MudTh>
                    <MudTh>動作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.DisplayName</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.caption">@(context.Provider ?? "—") / @(context.Model ?? "—")</MudText>
                    </MudTd>
                    <MudTd>
                        @* Stage 86 子項 2.2：switch Color 統一 Primary（對齊 WORKFLOW FLAGS） *@
                        <MudSwitch T="bool" Value="@context.IsActive"
                                   ValueChanged="@((bool v) => ToggleTalentActiveAsync(context, v))"
                                   Color="Color.Primary" />
                    </MudTd>
                    <MudTd>
                        @* Stage 86 子項 2.3：Petra (dispatcher) / Victoria (CEO) 0 Skill 設計意圖 — 明示 N/A *@
                        @if (context.Name is "Petra" or "Victoria")
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">N/A（dispatcher / CEO 角色）</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">
                                @string.Join(", ", context.Skills.Select(s => s.SkillName + (s.IsPrimary ? "*" : "")))
                            </MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenTalentSkillsAsync(context))">
                            管理 Skills
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_editingTalent is not null)
        {
            <MudPaper Elevation="2" Class="pa-3 mt-3">
                <MudText Typo="Typo.h6" Class="mb-2">@_editingTalent.Name — TalentSkill 多對多 assignment</MudText>
                @foreach (var skill in _allSkillNames)
                {
                    var assigned = _editingTalent.Skills.FirstOrDefault(s => s.SkillName == skill);
                    <div class="d-flex align-center justify-space-between py-1">
                        <MudCheckBox T="bool" Value="@(assigned is not null)"
                                     ValueChanged="@((bool v) => ToggleSkillAssignmentAsync(_editingTalent, skill, v))"
                                     Label="@skill" />
                        @if (assigned is not null)
                        {
                            <MudStack Row="true" Spacing="1">
                                <MudCheckBox T="bool" Value="@assigned.IsPrimary"
                                             ValueChanged="@((bool v) => SetSkillPrimaryAsync(_editingTalent, skill, v))"
                                             Label="Primary" />
                            </MudStack>
                        }
                    </div>
                }
                <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                           OnClick="@(() => _editingTalent = null)" Class="mt-2">關閉</MudButton>
            </MudPaper>
        }
    </MudTabPanel>

    @* Tab 5：SkillPrompts full CRUD — Stage 72 v5.5 Phase 2 SkillPrompt 版本管理（IsActive 切 / 不刪舊版本） *@
    <MudTabPanel Text="SkillPrompts" Icon="@Icons.Material.Filled.Article">
        <MudStack Row="true" Spacing="2" Class="mb-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadSkillPromptsAsync">重新載入</MudButton>
        </MudStack>

        @if (_skillPromptsActive.Count == 0)
        {
            <MudAlert Severity="Severity.Info">尚無 SkillPrompt 資料 — 預設 6 Skill baseline。</MudAlert>
        }
        else
        {
            <MudTable Items="_skillPromptsActive" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="SkillPromptRow">
                <HeaderContent>
                    <MudTh>SkillName</MudTh>
                    <MudTh>Active Version</MudTh>
                    <MudTh>Length</MudTh>
                    <MudTh>UpdatedAt</MudTh>
                    <MudTh>動作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SkillName</MudTd>
                    <MudTd>v@(context.VersionNumber)</MudTd>
                    <MudTd>@(context.PromptBody.Length) chars</MudTd>
                    <MudTd>@context.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenSkillPromptEditAsync(context))">
                            編輯（新版本）
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_editingSkillPrompt is not null)
        {
            <MudPaper Elevation="2" Class="pa-3 mt-3">
                <MudText Typo="Typo.h6" Class="mb-2">@_editingSkillPrompt.SkillName — 新版本 v@(_editingSkillPrompt.VersionNumber + 1)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    存檔後自動 VersionNumber +1 + IsActive=true / 舊版 IsActive=false（partial unique index 守同 SkillName 只一條 active）。舊版本保留 audit trail / 不刪除。
                </MudText>
                <MudTextField T="string" @bind-Value="_editingPromptBody"
                              Variant="Variant.Outlined" Lines="15" Class="mb-2" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="SaveNewSkillPromptVersionAsync">儲存新版本</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               OnClick="@(() => { _editingSkillPrompt = null; _editingPromptBody = string.Empty; })">取消</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>

    @* Tab 6：TalentPrompts full CRUD — Stage 72 v5.5 Phase 2 TalentPrompt（per-Talent persona / baseline 0 row） *@
    <MudTabPanel Text="TalentPrompts" Icon="@Icons.Material.Filled.Description">
        <MudStack Row="true" Spacing="2" Class="mb-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadTalentPromptsAsync">重新載入</MudButton>
        </MudStack>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            per-Talent persona body — 同 Skill 多 Talent 不重複存職責 / Talent 個性風格分開。
        </MudText>

        @if (_talents.Count == 0)
        {
            <MudAlert Severity="Severity.Info">尚無 Talent — 先到 Talents tab 確認 baseline。</MudAlert>
        }
        else
        {
            @* Stage 86 子項 2.4：擴 5 欄統一 SKILLPROMPTS 表（Talent / Active Version / Length / UpdatedAt / 動作） *@
            <MudTable Items="_talents" Dense="true" Hover="true" Height="600px" FixedHeader="true" T="TalentRow">
                <HeaderContent>
                    <MudTh>Talent</MudTh>
                    <MudTh>Active Version</MudTh>
                    <MudTh>Length</MudTh>
                    <MudTh>UpdatedAt</MudTh>
                    <MudTh>動作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var existing = _talentPromptsActive.FirstOrDefault(p => p.TalentId == context.Id);
                    }
                    <MudTd>@context.Name</MudTd>
                    <MudTd>
                        @if (existing is null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">未設定</MudChip>
                        }
                        else
                        {
                            <MudText>v@(existing.VersionNumber)</MudText>
                        }
                    </MudTd>
                    <MudTd>@(existing is null ? "—" : $"{existing.PersonaBody.Length} chars")</MudTd>
                    <MudTd>@(existing is null ? "—" : existing.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm"))</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenTalentPromptEditAsync(context.Id, context.Name, existing))">
                            編輯 persona
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_editingTalentPromptTalentId is not null)
        {
            <MudPaper Elevation="2" Class="pa-3 mt-3">
                <MudText Typo="Typo.h6" Class="mb-2">@_editingTalentPromptTalentName — Persona 編輯</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    存檔後自動 VersionNumber +1 + IsActive=true / 舊版 IsActive=false（partial unique index 守同 TalentId 只一條 active）。
                </MudText>
                <MudTextField T="string" @bind-Value="_editingPersonaBody"
                              Variant="Variant.Outlined" Lines="10" Class="mb-2"
                              Placeholder="風格 / 個性 / 語氣等" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="SaveNewTalentPromptVersionAsync">儲存新版本</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               OnClick="@(() => { _editingTalentPromptTalentId = null; _editingPersonaBody = string.Empty; })">取消</MudButton>
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>

    @* Tab 7：Rules + Projects — reuse 既有 RuleManagement + ProjectManagement page component（inline 整合） *@
    <MudTabPanel Text="Rules + Projects" Icon="@Icons.Material.Filled.Folder">
        <MudExpansionPanel Text="Rules（規則管理）" Expanded="true">
            <RuleManagement />
        </MudExpansionPanel>
        <MudExpansionPanel Text="Projects（專案管理）" Expanded="false">
            <ProjectManagement />
        </MudExpansionPanel>
    </MudTabPanel>

    @* Stage 85 子項 3：Tab 8 MockMode 砍（Tab 2「Token 守門 + 系統設定」已 cover 完整 Mock Mode toggle + Delay 範圍 / 純 dup 清理）*@

</MudTabs>
