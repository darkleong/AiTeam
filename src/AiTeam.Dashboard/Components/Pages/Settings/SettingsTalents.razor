@page "/settings/talents"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Data
@using AiTeam.Shared.Constants

<PageTitle>Talents - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>Talents</h2>
</div>

<div class="page-body">
<MudStack Row="true" Spacing="2" Class="mb-3">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _newTalentOpen = !_newTalentOpen)">
        @(_newTalentOpen ? "取消新增" : "新增 Talent")
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadTalentsAsync">重新載入</MudButton>
</MudStack>

@if (_newTalentOpen)
{
    <MudPaper Elevation="1" Class="pa-3 mb-3">
        <MudStack Spacing="2">
            <MudTextField T="string" @bind-Value="_newTalentName" Label="Name（對齊 worker name：Cody / Vera / Quinn / Sage 等）" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_newTalentDisplayName" Label="DisplayName" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_newTalentDescription" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="CreateTalentAsync">建立</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_talents.Count == 0)
{
    <MudAlert Severity="Severity.Info">尚無 Talent — 預設 6 instance：Cody / Vera / Quinn / Sage / Petra / Victoria。</MudAlert>
}
else
{
    <MudTable Items="_talents" Dense="true" Hover="true" Height="calc(100vh - 100px)" FixedHeader="true" T="TalentRow">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>DisplayName</MudTh>
            <MudTh>Provider / Model</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Skills</MudTh>
            <MudTh>動作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.DisplayName</MudTd>
            <MudTd>
                <MudText Typo="Typo.caption">@(context.Provider ?? "—") / @(context.Model ?? "—")</MudText>
            </MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="@context.IsActive"
                           ValueChanged="@((bool v) => ToggleTalentActiveAsync(context, v))"
                           Color="Color.Primary" />
            </MudTd>
            <MudTd>
                @if (context.Name is "Petra" or "Victoria")
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">N/A（dispatcher / CEO 角色）</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption">
                        @string.Join(", ", context.Skills.Select(s => s.SkillName + (s.IsPrimary ? "*" : "")))
                    </MudText>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="管理 Skills">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenTalentSkillsAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Text="LLM 設定（Provider/Model + Token Limit）">
                        <MudIconButton Icon="@Icons.Material.Outlined.Tune"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenTalentLlmEdit(context))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Stage 87 A3：Talent LLM 設定 edit panel（Provider/Model + Token Limit）*@
@if (_editingTalentLlm is not null)
{
    <MudPaper Elevation="2" Class="pa-3 mt-3">
        <MudText Typo="Typo.h6" Class="mb-2">@_editingTalentLlm.Name — LLM 設定</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            Provider / Model 修改後立即刷新 Bot TalentMetaCache（5 分鐘內生效）。
            Token Limit 留空（0）= 未設定，runtime fallback appsettings.json 預設值。
        </MudText>
        <MudStack Row="true" Spacing="2" Class="mb-2">
            <MudSelect T="string"
                       Label="Provider"
                       Value="@_llmEditProvider"
                       ValueChanged="@((string v) => OnLlmProviderChanged(v))"
                       Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="max-width:200px"
                       Disabled="@_isSavingLlm">
                @foreach (var p in LlmModels.AvailableProviders)
                {
                    <MudSelectItem Value="@p">@p</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string"
                       Label="Model"
                       @bind-Value="_llmEditModel"
                       Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="max-width:280px"
                       Disabled="@(_isSavingLlm || string.IsNullOrEmpty(_llmEditProvider))">
                @foreach (var m in LlmModels.GetModelsForProvider(_llmEditProvider ?? ""))
                {
                    <MudSelectItem Value="@m">@m</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="mb-2">
            <MudNumericField T="int?"
                             Label="日 Token 上限（千）"
                             @bind-Value="_llmEditDailyK"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="100000"
                             Style="max-width:200px"
                             Disabled="@_isSavingLlm" />
            <MudNumericField T="int?"
                             Label="月 Token 上限（千）"
                             @bind-Value="_llmEditMonthlyK"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Max="1000000"
                             Style="max-width:200px"
                             Disabled="@_isSavingLlm" />
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="SaveTalentLlmAsync"
                       Disabled="@_isSavingLlm">
                @(_isSavingLlm ? "儲存中..." : "儲存 LLM 設定")
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       OnClick="CloseTalentLlmEdit">取消</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_editingTalent is not null)
{
    <MudPaper Elevation="2" Class="pa-3 mt-3">
        <MudText Typo="Typo.h6" Class="mb-2">@_editingTalent.Name — TalentSkill 多對多 assignment</MudText>
        @foreach (var skill in _allSkillNames)
        {
            var assigned = _editingTalent.Skills.FirstOrDefault(s => s.SkillName == skill);
            <div class="d-flex align-center justify-space-between py-1">
                <MudCheckBox T="bool" Value="@(assigned is not null)"
                             ValueChanged="@((bool v) => ToggleSkillAssignmentAsync(_editingTalent, skill, v))"
                             Label="@skill" />
                @if (assigned is not null)
                {
                    <MudStack Row="true" Spacing="1">
                        <MudCheckBox T="bool" Value="@assigned.IsPrimary"
                                     ValueChanged="@((bool v) => SetSkillPrimaryAsync(_editingTalent, skill, v))"
                                     Label="Primary" />
                    </MudStack>
                }
            </div>
        }
        <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                   OnClick="@(() => _editingTalent = null)" Class="mt-2">關閉</MudButton>
    </MudPaper>
}
</div>
