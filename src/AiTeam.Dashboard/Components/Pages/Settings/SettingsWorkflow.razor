@page "/settings/workflow"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Workflow Flags - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>Workflow Flags</h2>
    @if (_pendingRestart)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-0">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-1" Size="Size.Small" />
                Workflow flag 變更後需重啟 Bot 才生效
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="RestartBotAsync" Disabled="@_isRestarting">
                @(_isRestarting ? "重啟中..." : "重啟 Bot")
            </MudButton>
        </MudStack>
    }
</div>

@if (_saveMessage is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-3">@_saveMessage</MudAlert>
}

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    21 Workflow:* flag 統一管理。修改後需重啟 Bot 才生效（settings cache 5 分鐘 re-read）。
</MudText>

<MudExpansionPanel Text="動態架構（6 flag）" Expanded="true">
    @foreach (var key in _v5Flags)
    {
        <div class="d-flex align-center justify-space-between py-2">
            <div>
                <MudText Typo="Typo.body2"><strong>@key</strong></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFlagDescription(key)</MudText>
            </div>
            <MudSwitch T="bool" Value="@GetBoolFlag(key)"
                       ValueChanged="@((bool v) => SetBoolFlagAsync(key, v))" Color="Color.Primary" />
        </div>
    }
</MudExpansionPanel>

<MudExpansionPanel Text="數值上限（6 flag）" Expanded="false">
    @foreach (var (key, min, max) in _numericFlags)
    {
        <div style="display:flex; align-items:center; width:100%; padding:8px 0">
            <div style="flex:1; min-width:0">
                <MudText Typo="Typo.body2"><strong>@key</strong></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFlagDescription(key)</MudText>
            </div>
            <MudNumericField T="int" Value="@GetIntFlag(key)"
                             ValueChanged="@((int v) => SetIntFlagAsync(key, v))"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="@min" Max="@max"
                             Style="width:160px; flex-shrink:0; margin-left:auto; text-align:right" />
        </div>
    }
</MudExpansionPanel>
