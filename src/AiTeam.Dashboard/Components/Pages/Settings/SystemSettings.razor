@page "/system-settings"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>系統設定 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>系統設定</h2>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
               StartIcon="@Icons.Material.Filled.CloudSync"
               OnClick="ReloadCacheAsync"
               Disabled="@_isReloading">
        @(_isReloading ? "套用中..." : "套用變更")
    </MudButton>
</div>

@if (_saveError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_saveError</MudAlert>
}
@if (_saveMessage is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-3">@_saveMessage</MudAlert>
}

<h3 style="margin-bottom:16px">一般設定</h3>

<div class="system-config-card">
    <div class="system-config-header">
        <div>
            <strong>跳過 CEO 派工確認</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後，老闆下指令時將直接進入 Agent 執行確認，省略 CEO 決策 Embed。<br/>
                建議 CEO 準確率穩定後再開啟。修改後 5 分鐘內自動生效，免重啟 Bot。
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_skipCeoConfirm"
                   ValueChanged="@OnSkipCeoConfirmChanged"
                   Color="Color.Primary"
                   Label="@(_skipCeoConfirm ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card system-config-card--warning">
    <div class="system-config-header">
        <div>
            <strong>Mock Mode（模擬模式）</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後，所有 AI 呼叫（Claude Code subprocess 與直接 LLM）改用預設模擬結果，不消耗 API 費用。<br/>
                適合 Dashboard / Discord 功能開發與流程測試。修改後 5 分鐘內自動生效，免重啟 Bot。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">⚠ 注意：所有 TaskLog / Discord embed 將標記為 [MOCK]，不建立真實 GitHub PR / branch。</MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_mockMode"
                   ValueChanged="@OnMockModeChanged"
                   Color="Color.Warning"
                   Label="@(_mockMode ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card">
    <div style="flex:1">
        <strong>Mock Mode 延遲範圍</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 12px">
            模擬 Agent 執行的隨機延遲範圍（毫秒）。預設 30000–60000（30–60 秒），模擬真實 Claude Code 執行時間。<br/>
            複驗單一缺失時可調小（如 1000–3000）加快速度。修改後 5 分鐘內自動生效。
        </p>
        <div class="d-flex align-center gap-3">
            <MudNumericField T="int" @bind-Value="_mockDelayMin"
                             Label="最小延遲 (ms)" Variant="Variant.Outlined"
                             Min="0" Max="600000" Step="1000" Style="max-width:180px" />
            <MudText>–</MudText>
            <MudNumericField T="int" @bind-Value="_mockDelayMax"
                             Label="最大延遲 (ms)" Variant="Variant.Outlined"
                             Min="1" Max="600000" Step="1000" Style="max-width:180px" />
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       OnClick="SaveMockDelayAsync"
                       Disabled="@(_isSavingMockDelay || !IsMockDelayValid())">
                @(_isSavingMockDelay ? "儲存中..." : "儲存")
            </MudButton>
        </div>
        @if (!IsMockDelayValid())
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Style="margin-top:6px">
                需滿足：0 ≤ 最小 &lt; 最大 ≤ 600000
            </MudText>
        }
    </div>
</div>

<MudDivider Style="margin: 32px 0" />

<h3 style="margin-bottom:16px">CEO 指令通道</h3>

<div class="system-config-card">
    <div style="flex:1">
        <strong>CEO 指令預設頻道 ID</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 12px">
            Dashboard 下達指令給 Victoria 時，用於發送 Discord Embed 的頻道 ID。<br/>
            未設定時，Dashboard 下指令將回傳錯誤提示。
        </p>
        <div class="d-flex align-center gap-3">
            <MudTextField T="string"
                          @bind-Value="_ceoChannelId"
                          Label="Discord 頻道 ID"
                          Placeholder="例：1234567890123456789"
                          Variant="Variant.Outlined"
                          Style="max-width:400px"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Tag" />
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       OnClick="SaveCeoChannelIdAsync"
                       Disabled="@_isSavingChannel">
                @(_isSavingChannel ? "儲存中..." : "儲存")
            </MudButton>
        </div>
        <MudDivider Style="margin: 20px 0" />
        <strong>Christ Discord User ID</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 12px">
            Dashboard 下達指令時，用於識別老闆身份並延續 Victoria 的對話 Session（與 Discord 共用同一段歷史）。<br/>
            可在 Discord 個人設定中開啟「開發者模式」後，右鍵帳號複製 User ID。
        </p>
        <div class="d-flex align-center gap-3">
            <MudTextField T="string"
                          @bind-Value="_christUserId"
                          Label="Discord User ID"
                          Placeholder="例：1234567890123456789"
                          Variant="Variant.Outlined"
                          Style="max-width:400px"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Person" />
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       OnClick="SaveChristUserIdAsync"
                       Disabled="@_isSavingUserId">
                @(_isSavingUserId ? "儲存中..." : "儲存")
            </MudButton>
        </div>
    </div>
</div>

<MudDivider Style="margin: 32px 0" />

<h3 style="margin-bottom:16px">流程輪次上限</h3>

<div class="system-config-card">
    <div style="flex:1">
        <p class="text-muted" style="font-size:0.85rem; margin:0 0 16px">
            各流程輪次上限設定。修改後 5 分鐘內自動生效，新任務會採用新設定（執行中任務沿用開始時讀取的數值）。<br/>
            值留空或設為 0 時，fallback 到 <code>appsettings.json</code> 預設值（目前皆為 3）。
        </p>

        <strong>Review Appeal 最大輪次</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            Cody 反駁 Vera Review 的最大輪次。拉高讓討論更充分，拉低（例如 1）加速驗收。超過此輪次後自動 escalate 給 Petra 仲裁。
        </p>
        <MudNumericField T="int" @bind-Value="_reviewAppealMaxRounds"
                         Label="輪次（1–10）" Variant="Variant.Outlined"
                         Min="1" Max="10" Style="max-width:180px" />

        <MudDivider Style="margin: 16px 0" />

        <strong>QA Fix 最大輪次</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            Petra 判定為 code_bug 後，Dev_fix + QA 重跑的最大輪次。超過後升級老闆人工介入。
        </p>
        <MudNumericField T="int" @bind-Value="_qaFixMaxRounds"
                         Label="輪次（1–10）" Variant="Variant.Outlined"
                         Min="1" Max="10" Style="max-width:180px" />

        <MudDivider Style="margin: 16px 0" />

        <strong>Dev_plan Appeal 最大輪次</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            Cody 反駁 Petra Dev_plan 初審的最大輪次（純 LLM 迴圈）。超過後升級給老闆。
        </p>
        <MudNumericField T="int" @bind-Value="_devPlanAppealMaxRounds"
                         Label="輪次（1–10）" Variant="Variant.Outlined"
                         Min="1" Max="10" Style="max-width:180px" />

        <MudDivider Style="margin: 16px 0" />

        <strong>Kick-off 會議最大輪次</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            Rosa/Demi/Cody/Quinn + Petra 討論需求的最大輪次。超過後 Petra 直接產出任務計劃書。
        </p>
        <MudNumericField T="int" @bind-Value="_kickoffMaxRounds"
                         Label="輪次（1–10）" Variant="Variant.Outlined"
                         Min="1" Max="10" Style="max-width:180px" />

        <MudDivider Style="margin: 16px 0" />

        <strong>設計會議最大輪次</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            設計會議（含調整重開）的最大輪次。超過後 escalate 給 Christ 裁決。
        </p>
        <MudNumericField T="int" @bind-Value="_designMeetingMaxRounds"
                         Label="輪次（1–10）" Variant="Variant.Outlined"
                         Min="1" Max="10" Style="max-width:180px" />

        <MudDivider Style="margin: 20px 0" />

        <div class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       OnClick="SaveWorkflowRoundsAsync"
                       Disabled="@_isSavingWorkflow">
                @(_isSavingWorkflow ? "儲存中..." : "儲存全部")
            </MudButton>
        </div>
    </div>
</div>

<MudDivider Style="margin: 32px 0" />

<h3 style="margin-bottom:16px">v4 漸進遷移控制 ⚠️ 實驗性</h3>

<div class="system-config-card system-config-card--warning">
    <div class="system-config-header">
        <div>
            <strong>使用 MS Agent Framework Appeal Loop</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後 <strong>Cody-Vera-Petra</strong> 與 <strong>Cody-Petra Dev_plan</strong> Appeal loop 改用 MS Agent Framework Workflow Builder + Checkpointing，<br/>
                替換 legacy <code>AppealOrchestrationService</code> 的手刻 while-loop（v4 遷移首發 Stage 49）。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">
                    ⚠️ 實驗性功能。啟用前確認 ANTHROPIC_API_KEY 設定 + 跑過 Mock 驗收（場景 framework_appeal_loop_*）。修改後 5 分鐘內自動生效。
                </MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_useFrameworkAppealLoop"
                   ValueChanged="@OnUseFrameworkAppealLoopChanged"
                   Color="Color.Warning"
                   Label="@(_useFrameworkAppealLoop ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card system-config-card--warning" style="margin-top: 16px;">
    <div class="system-config-header">
        <div>
            <strong>使用 MS Agent Framework Kickoff Meeting</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後 <strong>Kick-off 5 Agent 多輪會議</strong>（Rosa/Demi/Cody/Quinn 並行 + Petra 整理）改用 MS Agent Framework Workflow Builder fan-out/fan-in + Checkpointing，<br/>
                替換 legacy <code>KickoffMeetingService</code> 的手刻 for-loop（v4 漸進遷移第二步 Stage 50）。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">
                    ⚠️ 實驗性功能。啟用前請確認 ① ANTHROPIC_API_KEY 設定 ② 跑過 Mock 驗收（場景 framework_kickoff_*）③ Stage 49 Appeal Loop 已通過驗收。修改後 5 分鐘內自動生效。
                </MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_useFrameworkKickoff"
                   ValueChanged="@OnUseFrameworkKickoffChanged"
                   Color="Color.Warning"
                   Label="@(_useFrameworkKickoff ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card system-config-card--warning" style="margin-top: 16px;">
    <div class="system-config-header">
        <div>
            <strong>使用 MS Agent Framework HITL（Kickoff 中途介入試點）</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後 <strong>Kick-off 多輪會議</strong>進行期間可從流程追蹤頁點「✏️ 中途介入」按鈕，
                workflow 會在下個 Petra Round 邊界 yield 等老闆輸入修改指引（apply）或取消（cancel），
                從 framework checkpoint resume 繼續會議（v4 漸進遷移第三步 Stage 51 試點）。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">
                    ⚠️ 試點功能。需先啟用上方「MS Agent Framework Kickoff Meeting」，且 framework path
                    跑 Kick-off 時才有效（legacy path 不適用）。修改後 5 分鐘內自動生效。
                </MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_useFrameworkKickoffMidInterrupt"
                   ValueChanged="@OnUseFrameworkKickoffMidInterruptChanged"
                   Color="Color.Warning"
                   Disabled="@(!_useFrameworkKickoff)"
                   Label="@(_useFrameworkKickoffMidInterrupt ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card system-config-card--warning" style="margin-top: 16px;">
    <div class="system-config-header">
        <div>
            <strong>使用 MS Agent Framework Design Meeting</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後 <strong>設計規劃會議</strong>（Petra needsDemi 判斷 + Rosa Issues + 條件式 Demi UI 規格 + 4 Agent 並行 + needs_adjustment B2 子流程）改用 MS Agent Framework Workflow Builder
                fan-out/fan-in + Checkpointing + 條件式 short-circuit Demi 拓撲，
                替換 legacy <code>DesignMeetingService</code> 的手刻 for-loop（v4 漸進遷移第四步 Stage 52）。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">
                    ⚠️ 實驗性功能。啟用前請確認 ① ANTHROPIC_API_KEY 設定 ② 跑過 Mock 驗收（場景 framework_design_*）③ Stage 49/50/51 三 flag 已通過驗收。修改後 5 分鐘內自動生效。
                </MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_useFrameworkDesign"
                   ValueChanged="@OnUseFrameworkDesignChanged"
                   Color="Color.Warning"
                   Label="@(_useFrameworkDesign ? "啟用" : "停用")" />
    </div>
</div>

<div class="system-config-card system-config-card--warning" style="margin-top: 16px;">
    <div class="system-config-header">
        <div>
            <strong>使用 MS Agent Framework Pipeline</strong>
            <p class="text-muted" style="font-size:0.85rem; margin:4px 0 0">
                啟用後 NewFeature 主路徑從 <strong>Dev_plan 階段起</strong>（Dev_plan → Dev → Reviewer → QA → Doc → NotifyBossMerge）改走 MS Agent Framework Workflow path
                — macro-orchestration（5 Agent stage yield-resume + Checkpointing + ResumeStreamingAsync 跨 process restart），
                替換 legacy <code>WorkflowEngine.GetDecision</code> + <code>TaskGroupService.HandleAgentCompletedAsync</code> 散落 hooks（v4 漸進遷移第五步 Stage 53A）。<br/>
                <MudText Color="Color.Warning" Typo="Typo.body2" Inline="true">
                    ⚠️ 實驗性功能。啟用前請確認 ① ANTHROPIC_API_KEY 設定 ② 跑過 Mock 驗收（場景 framework_pipeline_*）③ <strong>Stage 50 UseFrameworkKickoff + Stage 52 UseFrameworkDesign 兩 flag 已通過驗收</strong>（三 flag 連動 — Kickoff/Design 留 legacy 由 Christ confirm BossInteraction 接 Pipeline 啟動）。
                    Aria 方案 C 拍板：53A 範圍縮小，Stage 55 收尾再整合 Kickoff/Design + sub-task 進 Pipeline framework。修改後 5 分鐘內自動生效。
                </MudText>
            </p>
        </div>
        <MudSwitch T="bool"
                   Value="@_useFrameworkPipeline"
                   ValueChanged="@OnUseFrameworkPipelineChanged"
                   Color="Color.Warning"
                   Disabled="@(!_useFrameworkKickoff || !_useFrameworkDesign)"
                   Label="@(_useFrameworkPipeline ? "啟用" : "停用")" />
    </div>
</div>

<MudDivider Style="margin: 32px 0" />

<h3 style="margin-bottom:16px">Token 守門設定</h3>

<div class="system-config-card">
    <div style="flex:1">
        <p class="text-muted" style="font-size:0.85rem; margin:0 0 16px">
            Token 守門數值（DB SoT）。儲存後 Bot Cache 立即刷新。<br/>
            <strong>顯示 0 代表 DB 尚未設定</strong>，Bot 目前 fallback 到 <code>appsettings.json</code>
            預設值（全域月限=20000K / 單次上限=200K）。設定非零值後 DB 接管。<br/>
            若要恢復 fallback 狀態（讓 appsettings 生效），可在 psql 執行：
            <code>DELETE FROM app_settings WHERE "Key" LIKE 'Token:%';</code>
        </p>

        <strong>全域月 Token 上限（千 token）</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            所有 Agent 本月合計用量上限。超過後所有 LLM 呼叫暫停，直到下月或手動調高。
        </p>
        <MudNumericField T="int" @bind-Value="_globalMonthlyLimitK"
                         Label="全域月限（千 token）" Variant="Variant.Outlined"
                         Min="0" Max="1000000" Step="1000" Style="max-width:240px" />

        <MudDivider Style="margin: 16px 0" />

        <strong>單次請求 Token 上限（千 token）</strong>
        <p class="text-muted" style="font-size:0.85rem; margin:4px 0 8px">
            單次 LLM 呼叫估算 Token 超過此值時，請求直接拒絕並發出警報（防止意外超大 prompt）。
        </p>
        <MudNumericField T="int" @bind-Value="_singleRequestLimitK"
                         Label="單次上限（千 token）" Variant="Variant.Outlined"
                         Min="0" Max="10000" Step="10" Style="max-width:240px" />

        <MudDivider Style="margin: 20px 0" />

        <div class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       OnClick="SaveTokenLimitsAsync"
                       Disabled="@(_isSavingTokenLimits || _globalMonthlyLimitK <= 0 || _singleRequestLimitK <= 0)">
                @(_isSavingTokenLimits ? "儲存中..." : "儲存")
            </MudButton>
        </div>
    </div>
</div>
