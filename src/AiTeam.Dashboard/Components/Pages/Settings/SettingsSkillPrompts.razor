@page "/settings/skill-prompts"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>SkillPrompts - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>SkillPrompts</h2>
</div>

<MudStack Row="true" Spacing="2" Class="mb-3">
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadSkillPromptsAsync">重新載入</MudButton>
</MudStack>

@if (_skillPromptsActive.Count == 0)
{
    <MudAlert Severity="Severity.Info">尚無 SkillPrompt 資料 — 預設 6 Skill baseline。</MudAlert>
}
else
{
    <MudTable Items="_skillPromptsActive" Dense="true" Hover="true" Height="calc(100vh - 220px)" FixedHeader="true" T="SkillPromptRow">
        <HeaderContent>
            <MudTh>SkillName</MudTh>
            <MudTh>Active Version</MudTh>
            <MudTh>Length</MudTh>
            <MudTh>UpdatedAt</MudTh>
            <MudTh>動作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.SkillName</MudTd>
            <MudTd>v@(context.VersionNumber)</MudTd>
            <MudTd>@(context.PromptBody.Length) chars</MudTd>
            <MudTd>@context.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm")</MudTd>
            <MudTd>
                <MudTooltip Text="編輯（新版本）">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenSkillPromptEditAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@if (_editingSkillPrompt is not null)
{
    <MudPaper Elevation="2" Class="pa-3 mt-3">
        <MudText Typo="Typo.h6" Class="mb-2">@_editingSkillPrompt.SkillName — 新版本 v@(_editingSkillPrompt.VersionNumber + 1)</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            存檔後自動 VersionNumber +1 + IsActive=true / 舊版 IsActive=false（partial unique index 守同 SkillName 只一條 active）。舊版本保留 audit trail / 不刪除。
        </MudText>
        <MudTextField T="string" @bind-Value="_editingPromptBody"
                      Variant="Variant.Outlined" Lines="15" Class="mb-2" />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="SaveNewSkillPromptVersionAsync">儲存新版本</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => { _editingSkillPrompt = null; _editingPromptBody = string.Empty; })">取消</MudButton>
        </MudStack>
    </MudPaper>
}
