@* Stage 83 子項 5：拿 @page directive 變純 component（dead / 0 caller）— /deployments route 改 DeploymentsRedirect.razor *@

<PageTitle>部署紀錄 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>部署紀錄</h2>
</div>

<MudTable Items="@_deployments"
          Dense="true"
          Hover="true"
          Height="calc(100vh - 100px)"
          FixedHeader="true"
          RowsPerPage="10"
          T="TaskItemDto"
          OnRowClick="OnRowClickAsync"
          RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>狀態</MudTh>
        <MudTh>任務標題</MudTh>
        <MudTh>專案</MudTh>
        <MudTh>部署時間</MudTh>
        <MudTh>完成時間</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><StatusBadge Status="@context.Status" /></MudTd>
        <MudTd>@context.Title</MudTd>
        <MudTd>@context.ProjectName</MudTd>
        <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>@context.CompletedAt?.ToString("yyyy/MM/dd HH:mm")</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
    </PagerContent>
</MudTable>

<TaskLogDrawer @bind-IsOpen="@_isDrawerOpen"
               SelectedTask="@_selectedTask"
               Logs="@_selectedLogs" />
