@using AiTeam.Dashboard.Services
@using Microsoft.AspNetCore.Components.Forms

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-3">快速下達指令</MudText>

    @if (_submitted)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">
            已送達 Victoria，請至操作中心查看回應。正在跳轉中…
        </MudAlert>
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_text"
                      Label="指令內容"
                      Placeholder="例：我想知道目前任務進度，並規劃下個 Stage..."
                      Lines="4"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Disabled="@_isSubmitting" />

        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                       @bind-Files="_selectedFiles"
                       @bind-Files:after="OnFilesValidated"
                       Accept=".png, .jpg, .jpeg, .gif, .webp"
                       MaximumFileCount="5"
                       AppendMultipleFiles="true"
                       Hidden="@false"
                       InputClass="absolute mud-width-full mud-height-full overflow-hidden z-20"
                       InputStyle="opacity:0"
                       Disabled="@_isSubmitting"
                       Class="mb-3"
                       @ondragenter="@(() => _dragActive = true)"
                       @ondragleave="@(() => _dragActive = false)"
                       @ondragend="@(() => _dragActive = false)"
                       @ondrop="@(() => _dragActive = false)">
            <ActivatorContent>
                <MudPaper Height="120px" Outlined="true"
                          Class="d-flex align-center justify-center"
                          Style="@($"border: 2px dashed {(_dragActive ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")}; background: {(_dragActive ? "var(--mud-palette-action-default-hover)" : "transparent")}; cursor:pointer; transition: all 0.15s ease-in-out;")">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">點擊選擇或拖移圖片到此處</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            最多 5 張，每張 ≤ 5MB，支援 PNG / JPEG / GIF / WebP
                        </MudText>
                    </MudStack>
                </MudPaper>
            </ActivatorContent>
        </MudFileUpload>

        @if (_selectedFiles is { Count: > 0 })
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var (file, index) in _selectedFiles.Select((f, i) => (f, i)))
                {
                    <MudChip T="string" OnClose="@(() => RemoveFile(index))"
                             Color="Color.Default" Size="Size.Small">
                        @file.Name (@(Math.Round(file.Size / 1024.0, 1)) KB)
                    </MudChip>
                }
            </div>
        }

        <div class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@_isSubmitting">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SubmitAsync"
                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_text))">
                @(_isSubmitting ? "送出中..." : "送出")
            </MudButton>
        </div>
    }
</MudPaper>
