@* Stage 33：全域佇列控制卡片 — 緊急停止 + 全部恢復。
    對齊 Discord /stop-all / /resume-all 指令，透過 /internal/queue/* fire-and-forget 送出。*@

<MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-left: 4px solid var(--mud-palette-warning)">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <div style="flex:1">
            <MudText Typo="Typo.subtitle2" Style="font-weight:600">🎛️ 全域佇列控制</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                緊急情況可一鍵暫停全部 Agent；執行中任務會跑完當輪，新任務會留在佇列不消費。
            </MudText>
        </div>

        <MudTooltip Text="所有 Agent 轉為 stopping（完成當輪任務後停止），需確認">
            <MudButton Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@_loading"
                       OnClick="StopAllAsync">
                🛑 緊急停止
            </MudButton>
        </MudTooltip>

        <MudTooltip Text="所有 Agent 恢復 active，立即開始消費佇列">
            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@_loading"
                       OnClick="ResumeAllAsync">
                ▶️ 全部恢復
            </MudButton>
        </MudTooltip>
    </MudStack>
</MudPaper>
