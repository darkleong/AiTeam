@using AiTeam.Dashboard.Services

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.h6">🎬 Mock 情境觸發</MudText>
        @if (!_mockModeEnabled)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                Mock Mode 未啟用
            </MudChip>
        }
    </MudStack>

    <p class="text-muted" style="font-size:0.85rem; margin:0 0 12px">
        等同於 Discord <code>/mock &lt;scenario&gt;</code> 指令。僅在系統設定啟用 Mock Mode 時可用。<br/>
        觸發後任務會出現在任務中心，所有輸出標記 <code>[MOCK]</code>、不建立真實 GitHub PR。
    </p>

    @if (!_mockModeEnabled)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">
            請先至
            <MudLink Href="/system-settings">系統設定</MudLink>
            啟用 Mock Mode 後再觸發情境。
        </MudAlert>
    }

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="4">
            <MudSelect T="string" @bind-Value="_project"
                       Label="Project（選填）" Variant="Variant.Outlined"
                       Placeholder="留空使用預設 repo"
                       Clearable="true"
                       Disabled="@(!_mockModeEnabled || _isSubmitting)">
                <MudSelectItem T="string" Value="@("")">（使用預設 repo）</MudSelectItem>
                @foreach (var project in _projects)
                {
                    <MudSelectItem T="string" Value="@project.Name">@project.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string" @bind-Value="_scenario"
                       Label="情境" Variant="Variant.Outlined"
                       Disabled="@(!_mockModeEnabled || _isSubmitting)">
                <MudSelectItem Value="@("new_feature")">✨ 新功能（無提案）</MudSelectItem>
                <MudSelectItem Value="@("new_feature_with_proposal")">📋 新功能（含提案）</MudSelectItem>
                <MudSelectItem Value="@("bug_fix")">🐛 Bug 修復</MudSelectItem>
                <MudSelectItem Value="@("tech_improvement")">🔧 技術改善</MudSelectItem>
                <MudSelectItem Value="@("fail_review")">❌ 失敗測試 — Review Appeal 失敗</MudSelectItem>
                <MudSelectItem Value="@("fail_qa")">❌ 失敗測試 — QA 失敗</MudSelectItem>
                <MudSelectItem Value="@("fail_dev_plan")">❌ 失敗測試 — Dev_plan Appeal 失敗</MudSelectItem>
                <MudSelectItem Value="@("review_skipped")">⏭️ 略過驗收 — Vera 略過（無可審檔案）</MudSelectItem>
                @* Stage 43：FF 三十二 Orchestrator 行為層 4 場景 *@
                <MudSelectItem Value="@("dev_plan_fail_retry")">🔄 Stage43 — DevPlan 重產成功（第 1 次失敗 → 第 2 次成功）</MudSelectItem>
                <MudSelectItem Value="@("dev_plan_fail_escalate")">⚠️ Stage43 — DevPlan 重產上限（連 2 次失敗 → escalate）</MudSelectItem>
                <MudSelectItem Value="@("dev_failed_intervention")">⚠️ Stage43 — Dev 失敗中止（needs_intervention）</MudSelectItem>
                <MudSelectItem Value="@("qa_failed_fix_then_intervention")">⚠️ Stage43 — QA fix loop 上限（needs_intervention）</MudSelectItem>
                @* Stage 45：FF 三十四 TaskGroup 流程暫停 3 場景 *@
                <MudSelectItem Value="@("pause_at_kickoff_end")">⏸️ Stage45 — Kickoff 結束自動暫停（驗 Design 不啟動）</MudSelectItem>
                <MudSelectItem Value="@("pause_during_dev")">⏸️ Stage45 — Dev 進行中暫停（驗被動延遲生效）</MudSelectItem>
                <MudSelectItem Value="@("pause_resume_with_boss_interaction")">⏸️ Stage45 — 跨 BossInteraction 暫停（驗議題 4 兩機制獨立）</MudSelectItem>
                @* Stage 46：FF 三十五 自動拆任務 2 場景 *@
                <MudSelectItem Value="@("split_task_propose_accept")">🪓 Stage46 — 拆 task 採納成功（拆 3 sub-task → Sequential 全跑通）</MudSelectItem>
                <MudSelectItem Value="@("split_task_subtask_fail_intervention")">🛑 Stage46 — 拆 task Phase 2 失敗（epic 部分暫停）</MudSelectItem>
                @* Stage 53B：4 子流程 framework 化 6 場景（v4 漸進遷移第六步驗收）*@
                <MudSelectItem Value="@("framework_pipeline_fix_loop_recover_round1")">🔧 Stage53B — fix loop Round 1 fail → Round 2 pass</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_fix_loop_max_iter")">🛑 Stage53B — fix loop max 3 輪 → intervention</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_dev_blocker_appeal")">🚧 Stage53B — Dev [BLOCKED] → Petra continue → Round 2 pass</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_qa_no_tests_dynamic")">🧪 Stage53B — QA no_tests → Petra approve → Doc</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_reviewer_fallback_dynamic")">🔁 Stage53B — Reviewer Critical + Petra revise → fix loop</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_fix_loop_crash_recovery")">💥 Stage53B — fix loop Crash Recovery（DevFix yield 期間 docker restart）</MudSelectItem>
                @* Stage 55A：Pipeline 從 Kickoff 啟動 4 alias（v4 漸進遷移第八步驗收 — 議題 G3 解法） *@
                <MudSelectItem Value="@("framework_pipeline_kickoff_to_merge_full")">⭐ Stage55A — Pipeline 從 Kickoff 跑通完整 pipeline（場景 B）</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_kickoff_crash_recovery")">💥 Stage55A — Kickoff 階段 Crash Recovery（場景 C）</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_design_crash_recovery_issue_idempotency_v2")">🛡️ Stage55A — Design 階段 B2 idempotency（場景 D）</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_subtask_chain")">🔗 Stage55A — sub-task 整合 Pipeline framework path（場景 E）</MudSelectItem>
                @* Stage 49：FF 四十九 framework Appeal Loop 5 場景 *@
                <MudSelectItem Value="@("framework_appeal_loop_fast_approve")">🚀 Stage49 — Appeal fast approve（Vera 第 1 輪 approve）</MudSelectItem>
                <MudSelectItem Value="@("framework_appeal_loop_max_iter_approve")">🚀 Stage49 — Appeal max-iter Petra approve</MudSelectItem>
                <MudSelectItem Value="@("framework_appeal_loop_max_iter_reject")">🚀 Stage49 — Appeal max-iter Petra reject</MudSelectItem>
                <MudSelectItem Value="@("framework_appeal_loop_max_iter_escalate")">🚀 Stage49 — Appeal max-iter Petra escalate</MudSelectItem>
                <MudSelectItem Value="@("framework_appeal_loop_crash_recovery")">🚀 Stage49 — Appeal Round 2 Crash Recovery</MudSelectItem>
                @* Stage 50：framework Kickoff Meeting 5 場景 *@
                <MudSelectItem Value="@("framework_kickoff_consensus_round1")">🤝 Stage50 — Kickoff Round 1 consensus</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_consensus_round2")">🤝 Stage50 — Kickoff Round 2 consensus</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_max_iter")">🤝 Stage50 — Kickoff max iter</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_escalate")">🤝 Stage50 — Kickoff Petra escalate</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_crash_recovery")">🤝 Stage50 — Kickoff Round 2 Crash Recovery</MudSelectItem>
                @* Stage 51：framework HITL Kickoff 中途介入 4 場景 *@
                <MudSelectItem Value="@("framework_kickoff_mid_interrupt_apply")">✏️ Stage51 — Kickoff 中途介入 套用修改（場景 B）</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_mid_interrupt_cancel")">✏️ Stage51 — Kickoff 中途介入 取消（場景 E）</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_mid_interrupt_crash_during_wait")">✏️ Stage51 — Kickoff 中途介入 等待中 Crash（場景 D）</MudSelectItem>
                <MudSelectItem Value="@("framework_kickoff_mid_interrupt_no_trigger")">✏️ Stage51 — Kickoff 中途介入 不觸發 baseline（場景 F）</MudSelectItem>
                @* Stage 52：framework Design Meeting 6 場景 *@
                <MudSelectItem Value="@("framework_design_consensus_round1")">🎨 Stage52 — Design Round 1 consensus</MudSelectItem>
                <MudSelectItem Value="@("framework_design_consensus_round2")">🎨 Stage52 — Design Round 2 consensus</MudSelectItem>
                <MudSelectItem Value="@("framework_design_needs_adjustment_approved")">🎨 Stage52 — Design needs_adjustment → approved</MudSelectItem>
                <MudSelectItem Value="@("framework_design_needs_adjustment_needs_meeting")">🎨 Stage52 — Design needs_adjustment → needs_meeting</MudSelectItem>
                <MudSelectItem Value="@("framework_design_no_demi")">🎨 Stage52 — Design no_demi（純後端任務）</MudSelectItem>
                <MudSelectItem Value="@("framework_design_crash_recovery_during_round")">🎨 Stage52 — Design Round 期間 Crash Recovery</MudSelectItem>
                @* Stage 53A：framework Pipeline 6 場景（Aria 方案 C：Pipeline 從 Dev_plan 階段啟動）*@
                <MudSelectItem Value="@("framework_pipeline_happy_path")">🔧 Stage53A — Pipeline happy path</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_dev_plan_resume")">🔧 Stage53A — Pipeline DevPlan resume</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_dev_resume")">🔧 Stage53A — Pipeline Dev resume</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_qa_no_tests")">🔧 Stage53A — Pipeline QA no_tests</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_reviewer_fallback")">🔧 Stage53A — Pipeline Reviewer fallback</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_dev_plan_failed_escalate")">🔧 Stage53A — Pipeline DevPlan failed escalate</MudSelectItem>
                @* Stage 54：framework Recovery 升級 + idempotency 2 alias *@
                <MudSelectItem Value="@("framework_design_crash_recovery_issue_idempotency")">🛡️ Stage54 — Design Crash Recovery Issue idempotency</MudSelectItem>
                <MudSelectItem Value="@("pipeline_dev_blocker_retry_idempotency")">🛡️ Stage54 — Pipeline DevBlocker retry idempotency</MudSelectItem>
                @* Stage 55B：5 type-specific intervention HITL alias 場景 *@
                <MudSelectItem Value="@("framework_pipeline_dev_intervention_hitl")">⚠️ Stage55B — Pipeline Dev intervention HITL</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_qa_intervention_hitl")">⚠️ Stage55B — Pipeline QA intervention HITL</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_devplan_escalate_hitl")">⚠️ Stage55B — Pipeline DevPlan escalate HITL</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_devplan_unable_hitl")">⚠️ Stage55B — Pipeline DevPlan unable HITL</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_split_task_proposal_hitl")">⚠️ Stage55B — Pipeline split-task proposal HITL</MudSelectItem>
                @* Stage 57：FF 五十一 race condition + FF 五十二 fix loop limit *@
                <MudSelectItem Value="@("framework_pipeline_epic_race_double_fail")">🌀 Stage57 — Epic race condition 雙 fail（FF 五十一）</MudSelectItem>
                <MudSelectItem Value="@("framework_pipeline_reviewer_fix_loop_limit")">🔁 Stage57 — Vera fix loop ×3 達 limit（FF 五十二）</MudSelectItem>
                @* Stage 58：FF 五十三 Agent API 失敗容錯性 *@
                <MudSelectItem Value="@("framework_pipeline_agent_api_failure")">💸 Stage58 — Agent API 失敗（餘額不足 / 401）容錯性（FF 五十三）</MudSelectItem>
                @* Stage 61：Petra/Cody prompt 對齊 + Pipeline UI refresh + Dashboard 補強 7 場景 *@
                <MudSelectItem Value="@("petra_decision_pack_check")">🎯 Stage61 — Petra 決策包紀律驗證（FF 五十六）</MudSelectItem>
                <MudSelectItem Value="@("cody_devplan_structured_check")">📐 Stage61 — Cody Dev_plan 結構規範驗證（FF 二十五）</MudSelectItem>
                <MudSelectItem Value="@("cody_implementationnote_written_check")">📝 Stage61 — Cody ImplementationNote 強制寫驗證（FF 四十六）</MudSelectItem>
                <MudSelectItem Value="@("framework_modify_taskplan_display_check")">🔄 Stage61 — Pipeline modify TaskPlan Reload 驗證（議題 #B）</MudSelectItem>
                <MudSelectItem Value="@("dashboard_isestimated_visual_check")">👁️ Stage61 — Dashboard token IsEstimated 視覺驗證（FF 五十）</MudSelectItem>
                <MudSelectItem Value="@("christ_action_supersede_check")">⏭️ Stage61 — Christ action supersede + intervention 訊息動態化（FF 四十五）</MudSelectItem>
                <MudSelectItem Value="@("epic_chain_dashboard_ui_check")">📦 Stage61 — Dashboard epic UI 接線驗證（FF 四十）</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_title"
                          Label="標題（選填）"
                          Placeholder="留空自動帶入 timestamp"
                          Variant="Variant.Outlined"
                          Disabled="@(!_mockModeEnabled || _isSubmitting)" />
        </MudItem>
    </MudGrid>

    <div class="d-flex justify-end">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="TriggerAsync"
                   Disabled="@(!_mockModeEnabled || _isSubmitting || string.IsNullOrWhiteSpace(_scenario))">
            @(_isSubmitting ? "觸發中..." : "🎬 觸發")
        </MudButton>
    </div>
</MudPaper>
