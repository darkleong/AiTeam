@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>首頁 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>總覽</h2>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done)" : "var(--color-status-failed)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
    </MudStack>
</div>

@* Stage 86 子項 2.5：4 metric 速覽卡乾淨化（icon + 標題 + 數字 / 紅字描述移 MudTooltip hover） *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudTooltip Text="PetraSession running + paused" Inline="false">
            <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle2" Class="mt-2">Active 任務</MudText>
                <MudText Typo="Typo.h4">@_activeSessionCount</MudText>
            </MudPaper>
        </MudTooltip>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudTooltip Text="PetraInbox 待 dispatch" Inline="false">
            <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle2" Class="mt-2">Pending 收件</MudText>
                <MudText Typo="Typo.h4">@_pendingInboxCount</MudText>
            </MudPaper>
        </MudTooltip>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudTooltip Text="BossInteraction pending" Inline="false">
            <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Large" Color="Color.Warning" />
                <MudText Typo="Typo.subtitle2" Class="mt-2">待處理確認卡</MudText>
                <MudText Typo="Typo.h4">@_pendingHitlCount</MudText>
            </MudPaper>
        </MudTooltip>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudTooltip Text="Input + Output 合計" Inline="false">
            <MudPaper Elevation="2" Class="pa-4" Style="text-align:center; min-height:130px">
                <MudIcon Icon="@Icons.Material.Filled.Token" Size="Size.Large" Color="Color.Info" />
                <MudText Typo="Typo.subtitle2" Class="mt-2">今日 Token</MudText>
                <MudText Typo="Typo.h4">@_todayTokenTotal.ToString("N0")</MudText>
            </MudPaper>
        </MudTooltip>
    </MudItem>
</MudGrid>

@* Stage 83 子項 1：3 分區跳轉按鈕 *@
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Assignment"
                   OnClick="@(() => Nav.NavigateTo("/tasks"))">
            任務中心
        </MudButton>
    </MudItem>
    @* follow-up #9：跳轉按鈕順序同步 NavMenu — 監控中心 在 設定中心 前 *@
    <MudItem xs="12" sm="4">
        <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.MonitorHeart"
                   OnClick="@(() => Nav.NavigateTo("/monitoring"))">
            監控中心
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="@(() => Nav.NavigateTo("/settings"))">
            設定中心
        </MudButton>
    </MudItem>
</MudGrid>

@* Stage 83 子項 1：保留 QuickCommandCard reuse（Home 入口頁 — Christ 快速送 CEO command） *@
<QuickCommandCard />
