@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>首頁 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>總覽</h2>
    <div style="display:flex; align-items:center; gap:12px;">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done,#22c55e)" : "var(--color-status-failed,#ef4444)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
        <button class="btn btn-secondary" style="font-size:0.8rem; padding:4px 10px;"
                @onclick="TestSignalRAsync">測試推送</button>
    </div>
</div>

<section class="agent-status-section">
    <h3>Agent 狀態</h3>
    @if (_agentStatuses.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">🤖</div>
            <p class="empty-state-title">尚未載入 Agent 資料</p>
            <p class="empty-state-hint">請確認 Bot 服務已啟動，並重新整理頁面</p>
        </div>
    }
    else
    {
        <MudGrid Spacing="2" Class="mb-2">
            @foreach (var agent in _agentStatuses)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Elevation="1" Class="pa-2 d-flex align-center" Style="gap:8px; min-height:52px">
                        <div style="flex:1; overflow:hidden">
                            <MudText Typo="Typo.body2" Style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                                @agent.AgentName
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                今日完成 @agent.TodayCompletedCount
                            </MudText>
                        </div>
                        <StatusBadge Status="@agent.Status" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</section>

<section class="recent-tasks-section">
    <h3>最近流程</h3>
    <div class="task-list-simple">
        @foreach (var group in _recentGroups)
        {
            <div class="task-row">
                <StatusBadge Status="@group.Status" />
                <MudChip T="string" Size="Size.Small" Color="@WorkflowTypeColor(group.WorkflowType)"
                         Style="margin:0">
                    @WorkflowTypeLabel(group.WorkflowType)
                </MudChip>
                <span class="task-title">@group.Title</span>
                <small>@group.CreatedAt.ToLocalTime().ToString("MM/dd HH:mm")</small>
                @if (!string.IsNullOrEmpty(group.DevPrUrl))
                {
                    <MudLink Href="@group.DevPrUrl" Target="_blank" Typo="Typo.caption">PR</MudLink>
                }
            </div>
        }
        @if (_recentGroups.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <p class="empty-state-title">還沒有任何流程</p>
                <p class="empty-state-hint">去 Discord 的 <strong>#victoria-ceo</strong> 頻道下達指令，或直接在各 Agent 頻道分配任務</p>
            </div>
        }
    </div>
</section>
