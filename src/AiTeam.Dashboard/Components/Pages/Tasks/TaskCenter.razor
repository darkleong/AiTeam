@page "/tasks"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>任務列表 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>任務列表</h2>
</div>

<div class="page-filters mb-3">
    <select @bind="_statusFilter" @bind:after="OnStatusFilterChangedAsync" class="form-select">
        <option value="">全部狀態</option>
        <option value="pending">等待中</option>
        <option value="running">執行中</option>
        <option value="done">完成</option>
        <option value="failed">失敗</option>
    </select>
</div>

<div style="overflow-x: auto; max-width: 100%;">
<MudTable @ref="_tableRef"
          ServerData="LoadServerDataAsync"
          Dense="true"
          Hover="true"
          Height="600px"
          FixedHeader="true"
          RowsPerPage="10"
          T="TaskItemDto"
          OnRowClick="OnTaskRowClickAsync"
          RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>狀態</MudTh>
        <MudTh>任務標題</MudTh>
        <MudTh>Agent</MudTh>
        <MudTh>專案</MudTh>
        <MudTh>觸發來源</MudTh>
        <MudTh>建立時間</MudTh>
        <MudTh>完成時間</MudTh>
        <MudTh>執行耗時</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><StatusBadge Status="@context.Status" /></MudTd>
        <MudTd>@context.Title</MudTd>
        <MudTd>@context.AssignedAgent</MudTd>
        <MudTd>@context.ProjectName</MudTd>
        <MudTd>@context.TriggeredBy</MudTd>
        <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>@context.CompletedAt?.ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>@FormatDuration(context.Duration)</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
    </PagerContent>
</MudTable>
</div>

<TaskLogDrawer @bind-IsOpen="@_isTaskDrawerOpen"
               SelectedTask="@_selectedTask"
               Logs="@_selectedLogs" />
