@page "/tasks"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>任務列表 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>任務列表</h2>
</div>

<div class="page-filters mb-3">
    <MudSelect T="string" MultiSelection="true"
               @bind-SelectedValues="_statusFilters"
               @bind-SelectedValues:after="OnStatusFilterChangedAsync"
               Label="篩選狀態" Dense="true" Style="max-width:300px"
               AdornmentIcon="@Icons.Material.Filled.FilterList">
        <MudSelectItem Value="@("pending")">等待中</MudSelectItem>
        <MudSelectItem Value="@("running")">執行中</MudSelectItem>
        <MudSelectItem Value="@("done")">完成</MudSelectItem>
        <MudSelectItem Value="@("failed")">失敗</MudSelectItem>
        <MudSelectItem Value="@("revision")">修正中</MudSelectItem>
        <MudSelectItem Value="@("reviewing")">審核中</MudSelectItem>
        <MudSelectItem Value="@("cancelled")">已取消</MudSelectItem>
    </MudSelect>
</div>

<MudTable @ref="_tableRef"
          ServerData="LoadServerDataAsync"
          Dense="true"
          Hover="true"
          Height="600px"
          FixedHeader="true"
          RowsPerPage="10"
          T="TaskItemDto"
          OnRowClick="OnTaskRowClickAsync"
          RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>狀態</MudTh>
        <MudTh>任務標題</MudTh>
        <MudTh>Agent</MudTh>
        <MudTh>專案</MudTh>
        <MudTh>觸發來源</MudTh>
        <MudTh>建立時間</MudTh>
        <MudTh>完成時間</MudTh>
        <MudTh>執行耗時</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><StatusBadge Status="@context.Status" /></MudTd>
        <MudTd>@context.Title</MudTd>
        <MudTd>@context.AssignedAgent</MudTd>
        <MudTd>@context.ProjectName</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@TriggeredByColor(context.TriggeredBy)">
                @context.TriggeredBy
            </MudChip>
        </MudTd>
        <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>@context.CompletedAt?.ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>@FormatDuration(context.Duration)</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
    </PagerContent>
</MudTable>

<TaskLogDrawer @bind-IsOpen="@_isTaskDrawerOpen"
               SelectedTask="@_selectedTask"
               Logs="@_selectedLogs" />
