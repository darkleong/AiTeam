@page "/tasks/hitl"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Dashboard.Components.Pages.Interactions
@using AiTeam.Shared.Dtos

<PageTitle>HITL 確認卡片 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>HITL 確認卡片（@_pendingHitl.Count）</h2>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done)" : "var(--color-status-failed)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
    </MudStack>
</div>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@if (_pendingHitl.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Class="mr-2" />
        目前無待處理確認卡片。
    </MudAlert>
}
else
{
    <MudStack Spacing="3">
        @foreach (var interaction in _pendingHitl)
        {
            <InteractionCard Interaction="interaction" OnRespond="HandleHitlResponseAsync" />
        }
    </MudStack>
}
