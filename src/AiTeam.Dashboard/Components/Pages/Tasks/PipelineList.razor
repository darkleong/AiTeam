@page "/pipeline"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>流程追蹤 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>流程追蹤</h2>
</div>

<div class="page-filters mb-3">
    <MudSelect T="string" MultiSelection="true"
               @bind-SelectedValues="_statusFilters"
               @bind-SelectedValues:after="OnStatusFilterChangedAsync"
               Label="篩選狀態" Dense="true" Style="max-width:300px"
               AdornmentIcon="@Icons.Material.Filled.FilterList">
        <MudSelectItem Value="@("pending")">等待中</MudSelectItem>
        <MudSelectItem Value="@("running")">執行中</MudSelectItem>
        <MudSelectItem Value="@("done")">已完成</MudSelectItem>
        <MudSelectItem Value="@("failed")">失敗</MudSelectItem>
        <MudSelectItem Value="@("revision")">修正中</MudSelectItem>
        <MudSelectItem Value="@("reviewing")">審核中</MudSelectItem>
        <MudSelectItem Value="@("cancelled")">已取消</MudSelectItem>
        <MudSelectItem Value="@("skipped")">略過</MudSelectItem>
        <MudSelectItem Value="@("needs_intervention")">需介入</MudSelectItem>
        <MudSelectItem Value="@("paused")">暫停中</MudSelectItem>
    </MudSelect>
</div>

<MudTable @ref="_groupTableRef"
          ServerData="LoadGroupServerDataAsync"
          Dense="true"
          Hover="true"
          Height="600px"
          FixedHeader="true"
          RowsPerPage="10"
          T="TaskGroupDto"
          OnRowClick="OnGroupRowClickAsync"
          RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>狀態</MudTh>
        <MudTh>任務標題</MudTh>
        <MudTh>流程類型</MudTh>
        <MudTh>專案</MudTh>
        <MudTh>建立時間</MudTh>
        <MudTh>PR</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><StatusBadge Status="@context.Status" /></MudTd>
        <MudTd>@context.Title</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@WorkflowTypeColor(context.WorkflowType)">
                @WorkflowTypeLabel(context.WorkflowType)
            </MudChip>
        </MudTd>
        <MudTd>@context.Project</MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd>
            @if (!string.IsNullOrEmpty(context.DevPrUrl))
            {
                @if (context.Title.Contains("[MOCK]"))
                {
                    <MudText Typo="Typo.body2">@PrNumberHelper.ExtractPrNumber(context.DevPrUrl)</MudText>
                }
                else
                {
                    <MudLink Href="@context.DevPrUrl" Target="_blank" rel="noopener" aria-label="@($"Open {PrNumberHelper.ExtractPrNumber(context.DevPrUrl)} on GitHub")">@PrNumberHelper.ExtractPrNumber(context.DevPrUrl)</MudLink>
                }
            }
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
    </PagerContent>
</MudTable>

<MudDrawer @bind-Open="_isPipelineDrawerOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="480px"
           OverlayAutoClose="true">
    <div class="drawer-header">
        <MudText Typo="Typo.h6" Style="flex:1">流程詳情</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _isPipelineDrawerOpen = false)" />
    </div>
    <div style="flex:1;overflow-y:auto;padding:12px">
        <PipelineView @ref="_pipelineViewRef"
                      Group="@_selectedGroup"
                      OnGroupStatusChanged="@OnGroupStatusChangedAsync" />
    </div>
</MudDrawer>
