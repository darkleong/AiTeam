@page "/tasks"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Data
@using AiTeam.Dashboard.Components.Pages.Interactions
@using AiTeam.Shared.Dtos

<PageTitle>任務中心 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>任務中心</h2>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <span style="font-size:0.85rem; color: @(_hubConnected ? "var(--color-status-done)" : "var(--color-status-failed)")">
            ● SignalR @(_hubConnected ? "已連線" : "未連線")
        </span>
    </MudStack>
</div>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudTabs Elevation="2" Rounded="true" PanelClass="pa-4" Position="Position.Top">

    @* Tab 1：HITL 確認卡片 — 議題 A1 plan_confirm + replan_confirm 完整 reuse InteractionCard / 其他 3 類 generic fallback *@
    <MudTabPanel Text="@($"HITL 確認卡片 ({_pendingHitl.Count})")" Icon="@Icons.Material.Filled.NotificationsActive">
        @if (_pendingHitl.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Class="mr-2" />
                目前無待處理確認卡片。
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var interaction in _pendingHitl)
                {
                    <InteractionCard Interaction="interaction" OnRespond="HandleHitlResponseAsync" />
                }
            </MudStack>
        }
    </MudTabPanel>

    @* Tab 2：進行中 Session — 議題 B1 ActiveSessions（running + paused） + 點開 drawer 顯示 PetraSessionMessages snippet *@
    <MudTabPanel Text="@($"進行中 Session ({_activeSessions.Count})")" Icon="@Icons.Material.Filled.PlayCircle">
        @if (_activeSessions.Count == 0)
        {
            <MudAlert Severity="Severity.Info">目前無進行中 Session。</MudAlert>
        }
        else
        {
            <MudTable Items="_activeSessions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                      Height="600px" FixedHeader="true"
                      OnRowClick="OnSessionRowClick" T="PetraSession" RowClass="cursor-pointer">
                <HeaderContent>
                    <MudTh>SessionId</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Replan</MudTh>
                    <MudTh>Cost (USD)</MudTh>
                    <MudTh>Updated</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Id.ToString()[..8]</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetSessionStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.ReplanIteration</MudTd>
                    <MudTd>@context.SessionCostUsd.ToString("F4")</MudTd>
                    <MudTd>@context.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    @* Tab 3：PetraInbox 收件 — 全 status + Attachments preview + 重跑（failed/dead） *@
    <MudTabPanel Text="@($"PetraInbox 收件 ({_inboxRows.Count})")" Icon="@Icons.Material.Filled.Inbox">
        @if (_inboxRows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">目前無 PetraInbox 收件。</MudAlert>
        }
        else
        {
            <MudTable Items="_inboxRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Height="600px" FixedHeader="true" T="PetraInbox">
                <HeaderContent>
                    <MudTh>UserInput</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Attachments</MudTh>
                    <MudTh>EnqueuedAt</MudTh>
                    <MudTh Style="white-space:nowrap; min-width:80px">動作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@(context.UserInput.Length > 80 ? context.UserInput[..80] + "..." : context.UserInput)</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Source == "dashboard" ? Color.Info : Color.Default)">
                            @context.Source
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @* Stage 85 子項 1：failed/dead status 視覺強化（Variant.Filled 實心 + Icon 警示）— 對齊 Christ 紀律「失敗告知不能讓老闆忽略」*@
                        <MudChip T="string" Size="Size.Small"
                                 Color="@InteractionCenter.GetInboxStatusColor(context.Status)"
                                 Variant="@(context.Status is "failed" or "dead" ? Variant.Filled : Variant.Text)"
                                 Icon="@(context.Status is "failed" or "dead" ? Icons.Material.Filled.ErrorOutline : null)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @* Stage 86 子項 3：MudChip 改 MudButton OnClick 開 AttachmentPreviewDialog *@
                        @if (CountAttachments(context.Attachments) > 0)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                       StartIcon="@Icons.Material.Filled.AttachFile"
                                       OnClick="@(() => OpenAttachmentDialogAsync(context.Attachments))">
                                @CountAttachments(context.Attachments) 張
                            </MudButton>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd>@context.EnqueuedAt.ToLocalTime().ToString("MM/dd HH:mm:ss")</MudTd>
                    <MudTd>
                        @if (context.Status is "failed" or "dead")
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       OnClick="@(() => HandleRequeueInboxAsync(context.Id))">
                                重跑
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    @* Tab 4：歷史 — PetraSession done/escalated/cancelled + Replan + cost + duration *@
    <MudTabPanel Text="歷史" Icon="@Icons.Material.Filled.History">
        @if (_historySessions.Count == 0)
        {
            <MudAlert Severity="Severity.Info">目前無歷史 Session。</MudAlert>
        }
        else
        {
            <MudTable Items="_historySessions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Height="600px" FixedHeader="true" T="PetraSession">
                <HeaderContent>
                    <MudTh>SessionId</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Replan</MudTh>
                    <MudTh>Cost (USD)</MudTh>
                    <MudTh Style="white-space:nowrap; min-width:80px">PR</MudTh>
                    <MudTh>Duration</MudTh>
                    <MudTh>Completed</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Id.ToString()[..8]</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetSessionStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd>@context.ReplanIteration</MudTd>
                    <MudTd>@context.SessionCostUsd.ToString("F4")</MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.ResultPrUrl))
                        {
                            <MudLink Href="@context.ResultPrUrl" Target="_blank" rel="noopener" aria-label="@($"Open {ExtractPrNumber(context.ResultPrUrl)} on GitHub")">
                                @ExtractPrNumber(context.ResultPrUrl)
                            </MudLink>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd>@FormatDuration(context.UpdatedAt - context.CreatedAt)</MudTd>
                    <MudTd>@context.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>
</MudTabs>

@* B1：Session detail drawer — 點 Active session row 開 / 顯示 PetraSessionMessages snippet *@
<MudDrawer @bind-Open="_isSessionDrawerOpen" Anchor="Anchor.End" Elevation="3" Width="600px" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Session 詳情</MudText>
    </MudDrawerHeader>
    <div class="pa-4" style="overflow-y:auto">
        @if (_selectedSession is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">Session @_selectedSession.Id</MudText>
            <MudChip T="string" Size="Size.Small" Color="@GetSessionStatusColor(_selectedSession.Status)" Class="mb-2">
                @_selectedSession.Status
            </MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Replan #@_selectedSession.ReplanIteration · Cost @_selectedSession.SessionCostUsd.ToString("F4") USD ·
                Updated @_selectedSession.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm:ss")
            </MudText>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Session Messages（最後 20 筆）</MudText>
            @if (_selectedSession.Messages.Count == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">無 message</MudText>
            }
            else
            {
                @foreach (var msg in _selectedSession.Messages.TakeLast(20))
                {
                    <MudCard Outlined="true" Class="my-2">
                        <MudCardContent Class="py-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @msg.Role · @msg.CreatedAt.ToLocalTime().ToString("HH:mm:ss")
                            </MudText>
                            <MudText Typo="Typo.body2" Style="white-space:pre-wrap; word-break:break-word; max-height:150px; overflow:auto">
                                @(msg.Content.Length > 500 ? msg.Content[..500] + "..." : msg.Content)
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
            }
        }
    </div>
</MudDrawer>
