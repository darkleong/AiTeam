@* Stage 18：Pipeline View - 垂直 MudStepper 顯示 TaskGroup 的各步驟 *@

@if (Group is null) return;

<div class="pipeline-header">
    <div class="pipeline-title">
        <MudText Typo="Typo.h6">@Group.Title</MudText>
        <StatusBadge Status="@Group.Status" />
        @if (Group.Title.Contains("[MOCK]"))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="pipeline-mock-badge">MOCK</MudChip>
        }
    </div>
    <div class="pipeline-meta">
        @if (!string.IsNullOrEmpty(Group.WorkflowType))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@WorkflowTypeLabel</MudChip>
        }
        @if (!string.IsNullOrEmpty(Group.Project))
        {
            <MudText Typo="Typo.caption" Class="ml-2">專案：@Group.Project</MudText>
        }
        <MudText Typo="Typo.caption" Class="ml-2">@Group.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudText>
        @if (!string.IsNullOrEmpty(Group.DevPrUrl))
        {
            @if (Group.Title.Contains("[MOCK]"))
            {
                <MudText Typo="Typo.caption" Class="ml-2">@PrNumberText</MudText>
            }
            else
            {
                <MudLink Href="@Group.DevPrUrl" Target="_blank" Typo="Typo.caption" Class="ml-2" rel="noopener" aria-label="@($"Open {PrNumberText} on GitHub")">@PrNumberText</MudLink>
            }
        }
    </div>
</div>

@* Stage 45：TaskGroup 流程暫停 / 恢復 *@
@if (Group.IsPaused)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Pause" Class="mb-2 mt-2">
        ⏸️ 暫停中
        @if (Group.PausedAt is not null)
        {
            <MudText Typo="Typo.caption" Class="ml-2">
                @($"（{Group.PausedBy ?? "Dashboard"} / {Group.PausedAt.Value.ToLocalTime():HH:mm:ss}）")
            </MudText>
        }
    </MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Variant="Variant.Filled"
               Size="Size.Small" Class="mb-3"
               OnClick="HandleResumeClickAsync" Disabled="@_pauseBusy">
        ▶️ 恢復下階段
    </MudButton>
}
else if (Group.Status is not "done" and not "failed" and not "cancelled")
{
    <MudButton StartIcon="@Icons.Material.Filled.Pause" Color="Color.Warning" Variant="Variant.Outlined"
               Size="Size.Small" Class="mb-3 mt-2"
               OnClick="HandlePauseClickAsync" Disabled="@_pauseBusy">
        ⏸️ 暫停下階段啟動
    </MudButton>
    @* Stage 51：framework HITL 中途介入按鈕（v4 漸進遷移第三步試點）— Kickoff 進行中且試點 flag 啟用時顯示 *@
    @if (CanShowMidInterruptButton)
    {
        <MudButton StartIcon="@Icons.Material.Filled.Edit" Color="Color.Info" Variant="Variant.Outlined"
                   Size="Size.Small" Class="mb-3 mt-2 ml-2"
                   OnClick="HandleMidInterruptClickAsync" Disabled="@_midInterruptBusy">
            ✏️ 中途介入 Kickoff
        </MudButton>
    }
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
}
else if (_steps.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mt-4 text-muted">尚無步驟資料</MudText>
}
else
{
    @* Stage 26：流程文件折疊面板（預設收合，有內容才顯示） *@
    @if (!string.IsNullOrEmpty(Group.TaskPlan) || !string.IsNullOrEmpty(Group.KickoffMeetingLog)
         || !string.IsNullOrEmpty(Group.DesignPlan) || !string.IsNullOrEmpty(Group.DesignMeetingLog)
         || !string.IsNullOrEmpty(Group.DevPlan) || !string.IsNullOrEmpty(Group.LastReviewBody)
         || !string.IsNullOrEmpty(Group.TestReport) || !string.IsNullOrEmpty(Group.ArchiveContent)
         || !string.IsNullOrEmpty(Group.ReviewAppealLog) || !string.IsNullOrEmpty(Group.DevPlanAppealLog))
    {
        <MudExpansionPanels Class="mb-3" MultiExpansion="true">
            @if (!string.IsNullOrEmpty(Group.TaskPlan))
            {
                <MudExpansionPanel Text="@($"🚀 Kick-off 任務計劃書（{Group.KickoffRound} 輪）")">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.TaskPlan</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.KickoffMeetingLog))
            {
                <MudExpansionPanel Text="🚀 Kick-off 會議紀錄">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.KickoffMeetingLog</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.DesignPlan))
            {
                <MudExpansionPanel Text="@($"🎨 設計規劃書（{Group.DesignRound} 輪）")">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.DesignPlan</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.DesignMeetingLog))
            {
                <MudExpansionPanel Text="🎨 設計會議紀錄">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.DesignMeetingLog</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.DevPlan))
            {
                <MudExpansionPanel Text="🔧 實作計劃書">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.DevPlan</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.LastReviewBody))
            {
                <MudExpansionPanel Text="🔍 驗收報告（Vera）">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.LastReviewBody</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.TestReport))
            {
                <MudExpansionPanel Text="🧪 測試報告（Quinn）">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.TestReport</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.ArchiveContent))
            {
                <MudExpansionPanel Text="📦 歸檔報告（Sage）">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.ArchiveContent</MudText>
                </MudExpansionPanel>
            }
            @* Stage 31：Appeal 對抗紀錄（Review / Dev_plan） *@
            @if (!string.IsNullOrEmpty(Group.ReviewAppealLog))
            {
                <MudExpansionPanel Text="@($"🗣️ Review Appeal 對抗紀錄（共 {Group.ReviewAppealRoundA} 輪）")">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.ReviewAppealLog</MudText>
                </MudExpansionPanel>
            }
            @if (!string.IsNullOrEmpty(Group.DevPlanAppealLog))
            {
                <MudExpansionPanel Text="@($"🗣️ Dev_plan Appeal 對抗紀錄（共 {Group.DevPlanAppealRoundA} 輪）")">
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Group.DevPlanAppealLog</MudText>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    <MudStepper @bind-ActiveIndex="_activeStepIndex"
                NonLinear="true"
                Vertical="true"
                Color="Color.Info"
                CompletedStepColor="Color.Success"
                SkippedStepColor="Color.Warning"
                ErrorStepColor="Color.Error"
                Class="mt-2 pipeline-stepper">
        @foreach (var step in _steps)
        {
            <MudStep Title="@GetStepTitle(step)"
                     Completed="@IsCompleted(step.Task.Status)"
                     HasError="@IsFailed(step.Task.Status)"
                     Skipped="@IsRevision(step.Task.Status)">
                <ChildContent>
                    <div class="pipeline-step-content">
                        <div class="d-flex align-center gap-2">
                            <StatusBadge Status="@step.Task.Status" />
                            <MudText Typo="Typo.caption">@FormatDuration(step.Task)</MudText>
                            @if (step.Task.Title.Contains("[MOCK]"))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">M</MudChip>
                            }
                        </div>

                        @if (step.LogsLoaded)
                        {
                            @if (step.Logs.Count > 0)
                            {
                                <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mt-2 pipeline-timeline">
                                    @foreach (var log in step.Logs)
                                    {
                                        <MudTimelineItem Color="@GetLogColor(log.Status)" Size="Size.Small">
                                            <ItemContent>
                                                <div class="d-flex align-center gap-2">
                                                    <StatusBadge Status="@log.Status" />
                                                    <MudText Typo="Typo.caption">@log.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</MudText>
                                                </div>
                                                <MudText Typo="Typo.body2">@log.Step</MudText>
                                                @if (!string.IsNullOrEmpty(log.Payload))
                                                {
                                                    <details class="pipeline-payload">
                                                        <summary>Payload</summary>
                                                        <pre>@log.Payload</pre>
                                                    </details>
                                                }
                                            </ItemContent>
                                        </MudTimelineItem>
                                    }
                                </MudTimeline>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="text-muted mt-1">無 Log 紀錄</MudText>
                            }
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       Class="mt-1"
                                       OnClick="@(() => LoadLogsAsync(step))">載入 Log</MudButton>
                        }
                        @* Stage 31：失敗 / 取消任務重試按鈕 *@
                        @if (step.Task.Status is "failed" or "cancelled" && step.Task.AssignedAgent is not ("Kickoff" or "Design"))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Class="mt-1 ml-1"
                                       OnClick="@(() => HandleRequeueAsync(step.Task.Id))">🔁 重試</MudButton>
                        }
                    </div>
                </ChildContent>
            </MudStep>
        }
    </MudStepper>
}
