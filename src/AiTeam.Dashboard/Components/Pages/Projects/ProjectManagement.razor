@* Stage 83 子項 5：拿 @page directive 變純 component（被 SettingsHub Rules + Projects tab reuse）— /projects route 改 ProjectsRedirect.razor *@
@* Stage 87 follow-up #13：砍 inner .page-header「專案管理」h2（跟 outer SettingsProjects.razor page-header「Projects」重複）/ button 改 inline action bar 靠右 *@

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateProjectDialogAsync">
        新增專案
    </MudButton>
</MudStack>

<MudTable Items="@_projects"
          Dense="true"
          Hover="true"
          Height="calc(100vh - 240px)"
          FixedHeader="true"
          RowsPerPage="10"
          T="ProjectDto"
          OnRowClick="OnRowClickAsync"
          RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>專案名稱</MudTh>
        <MudTh>團隊</MudTh>
        <MudTh>任務數</MudTh>
        <MudTh>啟用</MudTh>
        <MudTh>建立時間</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.TeamName</MudTd>
        <MudTd>@context.TaskCount</MudTd>
        <MudTd @onclick:stopPropagation="true">
            <MudSwitch T="bool"
                       Value="@context.IsActive"
                       ValueChanged="@((bool v) => ToggleIsActiveAsync(context, v))"
                       Color="Color.Primary"
                       Label="@(context.IsActive ? "啟用中" : "已停用")" />
        </MudTd>
        <MudTd>@context.CreatedAt.ToString("yyyy/MM/dd")</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
    </PagerContent>
    <NoRecordsContent>
        <div class="empty-state">
            <div class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Default" /></div>
            <p class="empty-state-title">還沒有任何專案</p>
            <p class="empty-state-hint">點擊右上角「新增專案」建立第一個專案，讓任務可以正確關聯</p>
        </div>
    </NoRecordsContent>
</MudTable>

<MudDrawer @bind-Open="_isDrawerOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="480px"
           OverlayAutoClose="true">
    @if (_selectedProject is not null)
    {
        <div class="drawer-header">
            <MudText Typo="Typo.h6" Style="flex:1">@_selectedProject.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDrawer" />
        </div>
        <div class="project-detail">
            <p><strong>團隊：</strong>@_selectedProject.TeamName</p>
            <p><strong>任務數量：</strong>@_selectedProject.TaskCount</p>
            <p>
                <strong>狀態：</strong>
                <MudSwitch T="bool"
                           Value="@_selectedProject.IsActive"
                           ValueChanged="@((bool v) => ToggleIsActiveAsync(_selectedProject, v))"
                           Color="Color.Primary"
                           Label="@(_selectedProject.IsActive ? "啟用中" : "已停用")" />
            </p>
            @if (_selectedProject.RepoUrl is not null)
            {
                <p><strong>Repo：</strong><a href="@_selectedProject.RepoUrl" target="_blank" rel="noopener" aria-label="Open repository on GitHub">@_selectedProject.RepoUrl</a></p>
            }
            @if (_selectedProject.TechStack is not null)
            {
                <div>
                    <strong>技術棧：</strong>
                    <pre>@_selectedProject.TechStack</pre>
                </div>
            }
            <p><strong>建立時間：</strong>@_selectedProject.CreatedAt.ToString("yyyy/MM/dd")</p>
        </div>
    }
</MudDrawer>
