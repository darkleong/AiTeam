@* 新增專案對話框 *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name"
                      Label="專案名稱"
                      Required="true"
                      RequiredError="專案名稱不可為空白"
                      Placeholder="例如：AiTeam"
                      Class="mb-3" />
        <MudTextField @bind-Value="_repoUrl"
                      Label="Repo URL"
                      Placeholder="https://github.com/owner/repo"
                      Class="mb-3" />
        <MudTextField @bind-Value="_techStack"
                      Label="技術棧"
                      Lines="3"
                      Placeholder=".NET 10, Blazor Server, PostgreSQL, Docker"
                      Class="mb-2" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitAsync" Disabled="@_isSubmitting">
            @(_isSubmitting ? "新增中..." : "確認新增")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private DashboardProjectService ProjectService { get; set; } = null!;

    private string  _name      = "";
    private string  _repoUrl   = "";
    private string  _techStack = "";
    private bool    _isSubmitting;
    private string? _error;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "專案名稱為必填。";
            return;
        }

        _isSubmitting = true;
        _error        = null;

        try
        {
            var created = await ProjectService.CreateProjectAsync(_name.Trim(), _repoUrl, _techStack);
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            _error = $"新增失敗：{ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
