@using System.Text.Json
@using AiTeam.Shared.Dtos
@using MudBlazor

<MudCard Outlined="true" Class="mb-2">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Icon="@InteractionCenter.GetInteractionIcon(Interaction.InteractionType)"
                     Color="@InteractionCenter.GetInteractionColor(Interaction.InteractionType)"
                     Size="Size.Medium" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">
                @InteractionCenter.GetInteractionLabel(Interaction.InteractionType)
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Interaction.Title
                @if (!string.IsNullOrWhiteSpace(Interaction.Project))
                {
                    <span> · @Interaction.Project</span>
                }
                @if (!string.IsNullOrWhiteSpace(Interaction.AgentName))
                {
                    <span> · @Interaction.AgentName</span>
                }
                <span> · @GetRelativeTime(Interaction.CreatedAt)</span>
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>

    @if (!string.IsNullOrWhiteSpace(Interaction.SystemNotes))
    {
        @* Stage 80 議題 4 W1+W2：SystemNotes 後端 SoT 區塊（取代前端 ParseDescription string pattern 耦合）。
           主題變數對齊（var(--mud-palette-background-grey) / var(--mud-palette-divider)）— 深色主題切換時視覺仍可辨識。 *@
        <MudCardContent Class="py-2"
                        Style="background: var(--mud-palette-background-grey); border-left: 3px solid var(--mud-palette-divider);">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Info" />
                <MudText Typo="Typo.caption" Style="white-space: pre-wrap; word-break: break-word;">
                    @Interaction.SystemNotes
                </MudText>
            </MudStack>
        </MudCardContent>
    }

    @if (!string.IsNullOrWhiteSpace(Interaction.Description))
    {
        <MudCardContent>
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">
                @Interaction.Description
            </MudText>
        </MudCardContent>
    }

    @if (Interaction.InteractionType == "replan_confirm" && _replanContext is not null)
    {
        @* Stage 81：replan_confirm UI render — Petra 建議 retry instruction + 觸發原因 + 進度顯示 + 原 worker output 預覽。
           對齊 plan_confirm pattern 但 render 內容不同（retry instruction string vs SubtaskPlan 結構 / W8 LangGraph cycles 紀律）。 *@
        <MudCardContent>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                🔄 觸發原因：@_replanContext.TriggerReason — Petra 建議 retry subtask #@_replanContext.CurrentSubtaskId
            </MudAlert>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                ✅ 已完成 @_replanContext.CompletedCount 個 subtask / 中斷在 #@_replanContext.CurrentSubtaskId（@_replanContext.CurrentTalentName / @_replanContext.CurrentSkillName）/ replan iteration #@_replanContext.ReplanIteration
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="mb-1">📌 Petra 建議 retry instruction</MudText>
            <MudPaper Outlined="true" Class="pa-2 mb-2" Style="background: var(--mud-palette-background-grey);">
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">@_replanContext.RetryInstruction</MudText>
            </MudPaper>
            @if (!string.IsNullOrWhiteSpace(_replanContext.LastOutputPreview))
            {
                <MudExpansionPanels Dense="true" Elevation="0">
                    <MudExpansionPanel Text="原 worker output 預覽（前 500 字）">
                        <MudText Typo="Typo.caption" Style="white-space: pre-wrap; word-break: break-word;">@_replanContext.LastOutputPreview</MudText>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudCardContent>
    }

    @if (Interaction.InteractionType == "plan_confirm")
    {
        @* Stage 80 子項 4：plan_confirm SubtaskPlan render（subtask 列表 + dependency 圖 + talent picks）。
           ContextJson 解析失敗 fallback render alert — 0 crash 紀律對齊 SubtaskPlanParser。 *@
        <MudCardContent>
            @if (_planSubtasks.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">📋 Petra 拆解計劃（@_planSubtasks.Count subtask）</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var st in _planSubtasks)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.AssignmentInd">
                            <MudText Typo="Typo.body2">
                                <strong>#@st.Id</strong> · @st.TalentName · <code>@st.Skill</code>
                                @if (st.NeedsImageContext)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1">附圖</MudChip>
                                }
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(st.Description))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@st.Description</MudText>
                            }
                        </MudListItem>
                    }
                </MudList>
                @if (_planDependencies.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        🔗 依賴關係：@string.Join("、", _planDependencies.Select(d => $"#{d.From} → #{d.To}（{d.Type}）"))
                    </MudText>
                }
            }
            else if (_planParseError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    無法解析 SubtaskPlan：@_planParseError
                </MudAlert>
            }
        </MudCardContent>
    }

    @if (Interaction.Status == "responded")
    {
        <MudCardActions Class="flex-column align-start">
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                已由 @Interaction.ResponseSource 回覆：@Interaction.ResponseAction
            </MudChip>
            @if (!string.IsNullOrWhiteSpace(Interaction.ResponseContent))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                    調整意見：@Interaction.ResponseContent
                </MudText>
            }
        </MudCardActions>
    }
    else if (Interaction.AvailableActions.Count > 0)
    {
        <MudCardActions>
            @foreach (var action in Interaction.AvailableActions)
            {
                var actionCopy = action;
                <MudButton Variant="Variant.Filled"
                           Color="@MapButtonColor(actionCopy.Color)"
                           Size="Size.Small"
                           Disabled="_isResponding"
                           OnClick="@(actionCopy.RequiresInput
                               ? () => TextInputAndRespondAsync(actionCopy)
                               : () => ConfirmAndRespondAsync(actionCopy))"
                           Class="mr-2">
                    @actionCopy.Label
                </MudButton>
            }
        </MudCardActions>
    }
</MudCard>

@code {
    [Parameter, EditorRequired]
    public BossInteractionDto Interaction { get; set; } = null!;

    [Parameter]
    public EventCallback<ResponseRequest> OnRespond { get; set; }

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    private bool _isResponding;

    // Stage 80 子項 4：plan_confirm ContextJson 解析後 cache（避免 render 內反覆 parse）。
    private List<PlanConfirmSubtaskView> _planSubtasks = new();
    private List<PlanConfirmDependencyView> _planDependencies = new();
    private string? _planParseError;

    // Stage 81：replan_confirm ContextJson 解析後 cache（對齊 plan_confirm pattern / 0 跨 type 重 parse）。
    private ReplanContextView? _replanContext;

    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true,
    };

    protected override void OnParametersSet()
    {
        if (Interaction.InteractionType == "plan_confirm" && !string.IsNullOrWhiteSpace(Interaction.ContextJson))
        {
            (_planSubtasks, _planDependencies, _planParseError) = ParsePlanContext(Interaction.ContextJson);
            _replanContext = null;
        }
        else if (Interaction.InteractionType == "replan_confirm" && !string.IsNullOrWhiteSpace(Interaction.ContextJson))
        {
            _replanContext = ParseReplanContext(Interaction.ContextJson);
            _planSubtasks = new();
            _planDependencies = new();
            _planParseError = null;
        }
        else
        {
            _planSubtasks = new();
            _planDependencies = new();
            _planParseError = null;
            _replanContext = null;
        }
    }

    private async Task ConfirmAndRespondAsync(InteractionActionDto action)
    {
        // Stage 81 議題 #3：replan_reject 用獨立確認文字 — 區分 Stage 80 plan_reject「拒絕」整個 cancel 語意
        // replan_reject = 接受原 worker output 繼續往下跑 / plan_reject = 整個任務取消
        var (title, message) = action.Id switch
        {
            "replan_reject" => ("確認不採納 Petra retry 建議",
                                "確定不採納 Petra 的 retry 建議 / 接受原結果繼續往下跑嗎？（任務不會取消 / 繼續執行剩餘 subtask）"),
            _               => ("確認回覆", $"確定執行「{action.Label}」？"),
        };

        var confirmed = await DialogService.ShowMessageBox(
            title, message,
            yesText: "確定", cancelText: "取消");

        if (confirmed != true) return;

        _isResponding = true;
        StateHasChanged();

        await OnRespond.InvokeAsync(new ResponseRequest(Interaction.Id, action.Id, null));

        _isResponding = false;
    }

    private async Task TextInputAndRespondAsync(InteractionActionDto action)
    {
        // Stage 80：plan_edit / plan_respond 文字輸入 prompt 對齊 4 decision pattern 語意
        var (title, prompt) = action.Id switch
        {
            "propose_adjust" => ("提案調整",         "請輸入您希望如何調整提案方向"),
            "kickoff_modify" => ("Kickoff 計劃修改", "請輸入您對任務計劃書的修改意見"),
            "design_modify"  => ("設計規劃修改",     "請輸入您對設計規劃書的修改指引"),
            "plan_edit"      => ("修改計劃",         "請輸入您對 Petra 拆解計劃的修改意見（例：Cody 只做 backend、UI 留 Vera 處理）"),
            "plan_respond"   => ("補充指示",         "請輸入額外指示或考量（例：另外考慮 mobile responsive）"),
            // Stage 81：replan_confirm 4 decision pattern
            "replan_edit"    => ("修改 retry instruction", "請輸入您對 Petra 建議的 retry instruction 的修改意見（例：請 Cody 改用其他方式 review）"),
            "replan_respond" => ("補充 retry 指示",   "請輸入額外指示或考量（例：請 Cody 加 mobile responsive 考量）"),
            _                => (action.Label,       "請輸入修改意見")
        };

        var parameters = new DialogParameters<TextInputDialog>
        {
            { x => x.Title,  title  },
            { x => x.Prompt, prompt }
        };
        var dialog = await DialogService.ShowAsync<TextInputDialog>(title, parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is string content && !string.IsNullOrWhiteSpace(content))
        {
            _isResponding = true;
            StateHasChanged();

            await OnRespond.InvokeAsync(new ResponseRequest(Interaction.Id, action.Id, content));

            _isResponding = false;
        }
    }

    private static Color MapButtonColor(string color) => color switch
    {
        "success" => Color.Success,
        "error"   => Color.Error,
        "warning" => Color.Warning,
        "info"    => Color.Info,
        _         => Color.Default
    };

    private static string GetRelativeTime(DateTime createdAt)
    {
        var diff = DateTime.UtcNow - createdAt;
        if (diff.TotalMinutes < 1)  return "剛剛";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} 分鐘前";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} 小時前";
        return $"{(int)diff.TotalDays} 天前";
    }

    // Stage 80 子項 4：plan_confirm ContextJson 解析（對齊 PetraOrchestratorService.PlanConfirmContext schema）。
    // JsonDocument 淺解避免雙端 PlanConfirmContext type linking — Dashboard 0 反向依賴 Bot 內部 record。
    private static (List<PlanConfirmSubtaskView> Subtasks, List<PlanConfirmDependencyView> Deps, string? Error) ParsePlanContext(string contextJson)
    {
        var subtasks = new List<PlanConfirmSubtaskView>();
        var deps = new List<PlanConfirmDependencyView>();
        try
        {
            using var doc = JsonDocument.Parse(contextJson);
            if (doc.RootElement.TryGetProperty("subtasks", out var subsProp) && subsProp.ValueKind == JsonValueKind.Array)
            {
                foreach (var s in subsProp.EnumerateArray())
                {
                    var id = s.TryGetProperty("id", out var idP) ? idP.GetInt32() : 0;
                    var skill = s.TryGetProperty("skill", out var skP) ? skP.GetString() ?? "" : "";
                    var desc = s.TryGetProperty("description", out var dP) ? dP.GetString() ?? "" : "";
                    var talent = s.TryGetProperty("talentName", out var tnP) ? tnP.GetString() ?? "" : "";
                    var needsImg = s.TryGetProperty("needsImageContext", out var niP)
                                   && niP.ValueKind == JsonValueKind.True;
                    subtasks.Add(new PlanConfirmSubtaskView(id, skill, desc, talent, needsImg));
                }
            }
            if (doc.RootElement.TryGetProperty("dependencies", out var depsProp) && depsProp.ValueKind == JsonValueKind.Array)
            {
                foreach (var d in depsProp.EnumerateArray())
                {
                    var from = d.TryGetProperty("from", out var fP) ? fP.GetInt32() : 0;
                    var to = d.TryGetProperty("to", out var toP) ? toP.GetInt32() : 0;
                    var type = d.TryGetProperty("type", out var tyP) ? tyP.GetString() ?? "sequential" : "sequential";
                    deps.Add(new PlanConfirmDependencyView(from, to, type));
                }
            }
            return (subtasks, deps, null);
        }
        catch (JsonException ex)
        {
            return (subtasks, deps, ex.Message);
        }
    }

    private sealed record PlanConfirmSubtaskView(int Id, string Skill, string Description, string TalentName, bool NeedsImageContext);

    private sealed record PlanConfirmDependencyView(int From, int To, string Type);

    // Stage 81：replan_confirm ContextJson 對應 view record（對齊後端 PetraOrchestratorService.ReplanConfirmContext schema / camelCase JsonOpts）。
    private sealed record ReplanContextView(
        int CurrentSubtaskId,
        string CurrentSkillName,
        string CurrentTalentName,
        string TriggerReason,
        string RetryInstruction,
        string LastOutputPreview,
        int CompletedCount,
        int ReplanIteration);

    // Stage 81：replan_confirm ContextJson 解析 — JsonDocument 淺解避免雙端 type linking（Dashboard 0 反向依賴 Bot 內部 record）。
    // schema 對齊 PetraOrchestratorService.ReplanConfirmContext（camelCase JsonOpts / PlanConfirmJsonOptions）。
    private static ReplanContextView? ParseReplanContext(string contextJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(contextJson);
            var root = doc.RootElement;
            return new ReplanContextView(
                CurrentSubtaskId:  root.TryGetProperty("currentSubtaskId", out var p1) && p1.ValueKind == JsonValueKind.Number ? p1.GetInt32() : 0,
                CurrentSkillName:  root.TryGetProperty("currentSkillName", out var p2) ? p2.GetString() ?? "" : "",
                CurrentTalentName: root.TryGetProperty("currentTalentName", out var p3) ? p3.GetString() ?? "" : "",
                TriggerReason:     root.TryGetProperty("triggerReason", out var p4) ? p4.GetString() ?? "" : "",
                RetryInstruction:  root.TryGetProperty("retryInstruction", out var p5) ? p5.GetString() ?? "" : "",
                LastOutputPreview: root.TryGetProperty("lastOutputPreview", out var p6) ? p6.GetString() ?? "" : "",
                CompletedCount:    root.TryGetProperty("completedCount", out var p7) && p7.ValueKind == JsonValueKind.Number ? p7.GetInt32() : 0,
                ReplanIteration:   root.TryGetProperty("replanIteration", out var p8) && p8.ValueKind == JsonValueKind.Number ? p8.GetInt32() : 0);
        }
        catch (JsonException)
        {
            return null;
        }
    }
}
