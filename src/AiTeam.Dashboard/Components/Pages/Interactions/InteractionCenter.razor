@page "/interactions"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using AiTeam.Shared.Dtos

<PageTitle>操作中心 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>操作中心</h2>
</div>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
}

@* 待處理區塊 *@
<MudText Typo="Typo.h6" Class="mb-2">
    待處理
    @if (_pending.Count > 0)
    {
        <MudBadge Content="@_pending.Count" Color="Color.Warning" Overlap="true" Class="ml-2">
            <span></span>
        </MudBadge>
    }
</MudText>

@if (_pending.Count == 0 && !_isLoading)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Class="mr-2" />
        目前沒有待處理的確認項目。
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="mb-4">
        @foreach (var interaction in _pending)
        {
            <InteractionCard Interaction="interaction" OnRespond="HandleResponseAsync" />
        }
    </MudStack>
}

@* 已處理區塊 *@
<MudText Typo="Typo.h6" Class="mb-2 mt-4">已處理</MudText>

@* 篩選列 *@
<MudPaper Elevation="0" Class="pa-3 mb-3" Style="background: var(--mud-palette-background-grey);">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudSelect T="string" Label="互動類型" Value="_typeFilter" ValueChanged="OnTypeFilterChanged"
                   Clearable="true" Dense="true" Style="min-width: 160px;">
            <MudSelectItem Value="@("ceo_confirm")">CEO 決策確認</MudSelectItem>
            <MudSelectItem Value="@("exec_confirm")">Agent 執行確認</MudSelectItem>
            <MudSelectItem Value="@("proposal")">提案確認</MudSelectItem>
            <MudSelectItem Value="@("kickoff")">Kickoff 確認</MudSelectItem>
            <MudSelectItem Value="@("design")">設計確認</MudSelectItem>
            <MudSelectItem Value="@("devplan_escalate")">Dev_plan 升級</MudSelectItem>
        </MudSelect>

        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="_sourceFilter"
                    SelectedValueChanged="@((v) => OnSourceFilterChanged(v))">
            <MudChip T="string" Value="@("")">全部</MudChip>
            <MudChip T="string" Value="@("discord")">Discord</MudChip>
            <MudChip T="string" Value="@("dashboard")">Dashboard</MudChip>
        </MudChipSet>

        <MudDateRangePicker Label="日期範圍" DateRange="_dateRange" DateRangeChanged="OnDateRangeChanged"
                            Clearable="true" AutoClose="true" />
    </MudStack>
</MudPaper>

@if (_historyLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mb-2" />
}
else if (_historyError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_historyError</MudAlert>
}
else if (_historyItems.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
        尚無符合條件的歷史回覆記錄。
    </MudAlert>
}
else
{
    <MudTable Items="_historyItems" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>類型</MudTh>
            <MudTh>標題</MudTh>
            <MudTh>專案</MudTh>
            <MudTh>回覆</MudTh>
            <MudTh>來源</MudTh>
            <MudTh>時間</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudIcon Icon="@GetInteractionIcon(context.InteractionType)" Size="Size.Small"
                         Color="@GetInteractionColor(context.InteractionType)" Class="mr-1" />
                @GetInteractionLabel(context.InteractionType)
            </MudTd>
            <MudTd>
                <div>@context.Title</div>
                @if (!string.IsNullOrWhiteSpace(context.ResponseContent))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        調整意見：@context.ResponseContent
                    </MudText>
                }
            </MudTd>
            <MudTd>@(context.Project ?? "—")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetActionColor(context.ResponseAction)">
                    @(context.ResponseAction ?? "—")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.ResponseSource == "dashboard" ? Color.Info : Color.Default)">
                    @(context.ResponseSource ?? "—")
                </MudChip>
            </MudTd>
            <MudTd>@(context.RespondedAt.HasValue ? context.RespondedAt.Value.ToLocalTime().ToString("MM/dd HH:mm") : "—")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] {15, 30, 50}" />
        </PagerContent>
    </MudTable>
}
