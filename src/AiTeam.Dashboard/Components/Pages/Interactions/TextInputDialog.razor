@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="InputText"
                      Label="@Prompt"
                      Lines="4"
                      MaxLength="2000"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(InputText)"
                   OnClick="Submit">送出</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Title  { get; set; } = "";
    [Parameter] public string Prompt { get; set; } = "";

    private string InputText { get; set; } = "";

    private void Cancel() => MudDialog.Cancel();
    private void Submit()  => MudDialog.Close(DialogResult.Ok(InputText));
}
