@page "/agents"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Agent 設定 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>Agent 設定</h2>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateAgentDialogAsync">
            新增 Agent
        </MudButton>
        @if (_showRestartConfirm)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                       OnClick="RestartBotAsync" Disabled="@_isRestarting">
                @(_isRestarting ? "重啟中..." : "確認重啟")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="@(() => _showRestartConfirm = false)">取消</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@(() => _showRestartConfirm = true)">
                重啟 Bot
            </MudButton>
        }
    </MudStack>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">
        <strong>載入失敗：</strong>@_loadError
    </MudAlert>
}
else if (_agents.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        尚未載入 Agent 資料，請確認 Bot 服務已啟動並重新整理頁面。
    </MudAlert>
}
else
{
    <MudGrid>
        @* 左欄：Agent 清單 *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="1">
                <MudList T="AgentConfigDto" @bind-SelectedValue="_selectedAgent" Color="Color.Primary">
                    @foreach (var agent in _agents)
                    {
                        <MudListItem Value="@agent">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%">
                                <MudText Typo="Typo.body2" Style="flex:1">@agent.Name</MudText>
                                <StatusBadge Status="@(agent.IsActive ? "idle" : "cancelled")" />
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        @* 右欄：詳情表單 *@
        <MudItem xs="12" md="8">
            @if (_selectedAgent is null)
            {
                <MudPaper Elevation="1" Class="pa-4 d-flex align-center justify-center" Style="min-height:200px">
                    <MudText Color="Color.Secondary">← 請從左側選擇 Agent</MudText>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="1" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-1">@_selectedAgent.Name</MudText>
                    @if (!string.IsNullOrEmpty(_selectedAgent.TeamName))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@_selectedAgent.TeamName</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_selectedAgent.Description))
                    {
                        <MudText Typo="Typo.body2" Class="mb-3 text-muted">@_selectedAgent.Description</MudText>
                    }
                    <MudDivider Class="mb-3" />

                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.body2">啟用狀態</MudText>
                        <MudSwitch T="bool"
                                   Value="@_selectedAgent.IsActive"
                                   ValueChanged="@((bool v) => ToggleIsActiveAsync(_selectedAgent, v))"
                                   Color="Color.Primary"
                                   Label="@(_selectedAgent.IsActive ? "啟用中" : "已停用")" />
                    </div>

                    <div class="mb-3">
                        <MudText Typo="Typo.body2" Class="mb-1">
                            信任等級：<strong>Lv@_trustLevels[_selectedAgent.Id]</strong>
                        </MudText>
                        <MudSlider Value="@_trustLevels[_selectedAgent.Id]"
                                   ValueChanged="@((int v) => _trustLevels[_selectedAgent.Id] = v)"
                                   Min="0" Max="3" Step="1"
                                   Style="max-width:240px" />
                    </div>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => SaveTrustLevelAsync(_selectedAgent))"
                               Disabled="@_isSaving">
                        @(_isSaving ? "儲存中..." : "儲存信任等級")
                    </MudButton>

                    <MudDivider Class="my-3" />

                    @* Stage 38：LLM Provider / Model 動態設定（DB 為權威，立即生效不需重啟） *@
                    <MudText Typo="Typo.subtitle2" Class="mb-2">LLM 設定</MudText>
                    <MudStack Row="true" Spacing="2" Class="mb-2">
                        <MudSelect T="string"
                                   Label="Provider"
                                   Value="@_selectedAgent.Provider"
                                   ValueChanged="@((string v) => OnProviderChangedAsync(_selectedAgent, v))"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Style="max-width:200px"
                                   Disabled="@_isSavingLlm">
                            @foreach (var p in LlmModels.AvailableProviders)
                            {
                                <MudSelectItem Value="@p">@p</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string"
                                   Label="Model"
                                   Value="@_selectedAgent.Model"
                                   ValueChanged="@((string v) => OnModelChangedAsync(_selectedAgent, v))"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Style="max-width:280px"
                                   Disabled="@(_isSavingLlm || string.IsNullOrEmpty(_selectedAgent.Provider))">
                            @foreach (var m in LlmModels.GetModelsForProvider(_selectedAgent.Provider ?? ""))
                            {
                                <MudSelectItem Value="@m">@m</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    @if (!string.IsNullOrEmpty(_selectedAgent.Provider)
                         && !string.IsNullOrEmpty(_selectedAgent.Model)
                         && !LlmModels.GetModelsForProvider(_selectedAgent.Provider).Contains(_selectedAgent.Model))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                            目前 Model「@_selectedAgent.Model」不在 Provider「@_selectedAgent.Provider」支援清單，請重新選擇。
                        </MudAlert>
                    }

                    <MudDivider Class="my-3" />

                    @* Stage 47：per-agent Token Limit 動態設定（DB SoT，null = fallback appsettings） *@
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Token 限額設定</MudText>
                    <p class="text-muted" style="font-size:0.85rem; margin:0 0 8px">
                        留空（0）表示未設定，Bot fallback appsettings.json 預設值（日限=1000K / 月限=5000K）。
                        修改後立即刷新 Bot Cache，5 分鐘內生效。
                    </p>
                    <MudStack Row="true" Spacing="2" Class="mb-2">
                        <MudNumericField T="int?"
                                         Label="日 Token 上限（千）"
                                         Value="@_selectedAgent.DailyTokenLimitK"
                                         ValueChanged="@((int? v) => _selectedAgent.DailyTokenLimitK = v)"
                                         Variant="Variant.Outlined"
                                         Min="0" Max="100000"
                                         Style="max-width:200px"
                                         Disabled="@_isSavingLlm" />
                        <MudNumericField T="int?"
                                         Label="月 Token 上限（千）"
                                         Value="@_selectedAgent.MonthlyTokenLimitK"
                                         ValueChanged="@((int? v) => _selectedAgent.MonthlyTokenLimitK = v)"
                                         Variant="Variant.Outlined"
                                         Min="0" Max="1000000"
                                         Style="max-width:200px"
                                         Disabled="@_isSavingLlm" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => SaveTokenLimitsAsync(_selectedAgent))"
                                   Disabled="@_isSavingLlm">
                            @(_isSavingLlm ? "儲存中..." : "儲存 Token 限額")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

