@page "/rules"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>規則管理 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>規則管理</h2>
    <button class="btn btn-primary" @onclick="ToggleCreateForm">
        @(_showCreateForm ? "✕ 取消新增" : "+ 新增規則")
    </button>
</div>

@if (_showCreateForm)
{
    <div class="agent-setting-card" style="margin-bottom:24px">
        <h4>新增規則</h4>
        <div class="form-group">
            <label>規則內容 <span style="color:red">*</span></label>
            <textarea class="form-control" @bind="_newContent" rows="3"
                      placeholder="例如：回應使用繁體中文，語氣專業但親切"></textarea>
        </div>
        <div class="form-group">
            <label>套用對象</label>
            <select class="form-select" @bind="_newAgentName" style="width:200px">
                @foreach (var opt in _agentOptions)
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>排序</label>
            <input type="number" class="form-control" @bind="_newSortOrder" style="width:100px" />
        </div>

        @if (_createError is not null)
        {
            <div class="alert alert-danger">@_createError</div>
        }

        <div class="agent-setting-actions">
            <button class="btn btn-primary" @onclick="CreateRuleAsync" disabled="@_isCreating">
                @(_isCreating ? "新增中..." : "確認新增")
            </button>
        </div>
    </div>
}

@if (_rules.Count == 0 && !_showCreateForm)
{
    <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <p class="empty-state-title">還沒有任何規則</p>
        <p class="empty-state-hint">點擊右上角「新增規則」來建立 CEO 的行為準則</p>
    </div>
}
else if (_rules.Count > 0)
{
    <MudTable Items="@_rules"
              Dense="true"
              Hover="true"
              Height="600px"
              FixedHeader="true"
              RowsPerPage="10"
              T="Rule">
        <HeaderContent>
            <MudTh>規則內容</MudTh>
            <MudTh>套用對象</MudTh>
            <MudTh>排序</MudTh>
            <MudTh>狀態</MudTh>
            <MudTh>操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (_editingId == context.Id)
            {
                <MudTd colspan="5">
                    <div class="form-group">
                        <textarea class="form-control" @bind="_editContent" rows="3"></textarea>
                    </div>
                    <div class="form-group" style="display:flex; align-items:center; gap:16px; flex-wrap:wrap">
                        <div>
                            <label>套用對象</label>
                            <select class="form-select" @bind="_editAgentName" style="width:180px">
                                @foreach (var opt in _agentOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>排序</label>
                            <input type="number" class="form-control" @bind="_editSortOrder" style="width:80px" />
                        </div>
                    </div>
                    <div style="display:flex; gap:8px; margin-top:8px">
                        <button class="btn btn-primary" @onclick="() => SaveEditAsync(context.Id)">儲存</button>
                        <button class="btn btn-secondary" @onclick="CancelEdit">取消</button>
                    </div>
                </MudTd>
            }
            else
            {
                <MudTd style="flex:1; font-size:0.9rem">@context.Content</MudTd>
                <MudTd>
                    <span class="status-badge" style="background:@GetAgentColor(context.AgentName)">
                        @(context.AgentName ?? "全域")
                    </span>
                </MudTd>
                <MudTd>
                    <span style="font-size:0.75rem; color:var(--color-text-secondary)">@context.SortOrder</span>
                </MudTd>
                <MudTd>
                    <MudSwitch T="bool"
                               Value="@context.IsActive"
                               ValueChanged="@((bool v) => ToggleActiveAsync(context, v))"
                               Color="Color.Primary"
                               Label="@(context.IsActive ? "啟用" : "停用")" />
                </MudTd>
                <MudTd>
                    <div style="display:flex; gap:8px">
                        <button class="btn btn-secondary" style="font-size:0.8rem; padding:4px 10px"
                                @onclick="() => StartEdit(context)">編輯</button>
                        <button class="btn btn-secondary" style="font-size:0.8rem; padding:4px 10px; color:var(--color-status-failed)"
                                @onclick="() => DeleteRuleAsync(context.Id)">刪除</button>
                    </div>
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
    </MudTable>
}
