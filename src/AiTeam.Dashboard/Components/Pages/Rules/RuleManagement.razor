@page "/rules"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>規則管理 - AI Team Dashboard</PageTitle>

<div class="page-header">
    <h2>規則管理</h2>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateRuleDialogAsync">
            新增規則
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CloudSync"
                   OnClick="ReloadCacheAsync"
                   Disabled="@_isReloading">
            @(_isReloading ? "套用中..." : "套用變更")
        </MudButton>
    </MudStack>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
}
@if (_formError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_formError</MudAlert>
}
@if (_loadError is null && _rules.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Default" /></div>
        <p class="empty-state-title">還沒有任何規則</p>
        <p class="empty-state-hint">點擊右上角「新增規則」來建立 CEO 的行為準則</p>
    </div>
}
else if (_rules.Count > 0)
{
    <MudTable Items="@_rules"
              Dense="true"
              Hover="true"
              Height="600px"
              FixedHeader="true"
              RowsPerPage="10"
              T="Rule">
        <HeaderContent>
            <MudTh>規則內容</MudTh>
            <MudTh>套用對象</MudTh>
            <MudTh>排序</MudTh>
            <MudTh>狀態</MudTh>
            <MudTh>操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd style="flex:1; font-size:0.9rem">@context.Content</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetAgentChipColor(context.AgentName)">
                    @(context.AgentName ?? "全域")
                </MudChip>
            </MudTd>
            <MudTd>
                <span style="font-size:0.75rem; color:var(--color-text-secondary)">@context.SortOrder</span>
            </MudTd>
            <MudTd>
                <MudSwitch T="bool"
                           Value="@context.IsActive"
                           ValueChanged="@((bool v) => ToggleActiveAsync(context, v))"
                           Color="Color.Primary"
                           aria-label="@(context.IsActive ? "已啟用，點擊停用" : "已停用，點擊啟用")" />
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="編輯">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditRuleDialogAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Text="刪除">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteRuleAsync(context.Id))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
    </MudTable>
}
