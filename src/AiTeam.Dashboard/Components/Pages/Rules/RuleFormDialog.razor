@* 規則新增 / 編輯對話框 *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_content"
                      Label="規則內容"
                      Required="true"
                      RequiredError="規則內容不可為空白"
                      Lines="3"
                      Placeholder="例如：回應使用繁體中文，語氣專業但親切"
                      Class="mb-3" />

        <MudSelect T="string" @bind-Value="_agentName"
                   Label="套用對象" Style="max-width:240px" Class="mb-3">
            @foreach (var opt in AgentOptions)
            {
                <MudSelectItem Value="@opt.Value">@opt.Label</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_sortOrder"
                         Label="排序" Style="max-width:120px" Class="mb-2" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitAsync" Disabled="@_isSubmitting">
            @(_isSubmitting ? "儲存中..." : (EditingRule is null ? "確認新增" : "儲存"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Inject]
    private DashboardRuleService RuleService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Parameter]
    public Rule? EditingRule { get; set; }

    [Parameter]
    public List<(string Label, string Value)> AgentOptions { get; set; } = [];

    [Parameter]
    public int NextSortOrder { get; set; } = 10;

    private string  _content    = "";
    private string  _agentName  = "";
    private int     _sortOrder;
    private bool    _isSubmitting;
    private string? _error;

    protected override void OnInitialized()
    {
        if (EditingRule is not null)
        {
            _content   = EditingRule.Content;
            _agentName = EditingRule.AgentName ?? "";
            _sortOrder = EditingRule.SortOrder;
        }
        else
        {
            _sortOrder = NextSortOrder;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_content))
        {
            _error = "規則內容為必填。";
            Snackbar.Add(_error, Severity.Warning);
            return;
        }

        _isSubmitting = true;
        _error        = null;

        try
        {
            if (EditingRule is null)
            {
                var created = await RuleService.CreateRuleAsync(_content, _agentName, _sortOrder);
                MudDialog.Close(DialogResult.Ok(created));
            }
            else
            {
                await RuleService.UpdateRuleAsync(EditingRule.Id, _content, _agentName, _sortOrder);
                EditingRule.Content   = _content;
                EditingRule.AgentName = string.IsNullOrWhiteSpace(_agentName) ? null : _agentName;
                EditingRule.SortOrder = _sortOrder;
                MudDialog.Close(DialogResult.Ok(EditingRule));
            }
        }
        catch (Exception ex)
        {
            _error = $"操作失敗：{ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
