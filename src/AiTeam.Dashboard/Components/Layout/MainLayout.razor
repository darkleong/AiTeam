@inherits LayoutComponentBase

@* Providers 需在 Interactive 環境執行（MudProviders.razor 有 @rendermode InteractiveServer），
   不能直接放在 Static SSR 的 Layout 裡，否則 Interactive pages 無法找到 scoped services *@
<MudProviders />

@* Stage 86 子項 5：砍 MudAppBar / hamburger 浮左上半透明 / hover overlay + click pin 兩態 *@
<span id="sidebar-hamburger" class="sidebar-hamburger-float" onclick="window.aiteamSidebar.toggle()">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" />
</span>

<MudLayout>
    @* Stage 86 子項 5 follow-up #3：砍 AppBar 後 ClipMode 從 Always 改 Never / drawer 從 viewport top 0 延伸到底（不留 AppBar 空白）*@
    <MudDrawer Open="true" id="main-sidebar" Variant="DrawerVariant.Persistent"
               Elevation="2" ClipMode="DrawerClipMode.Never">
        @* Stage 86 子項 5：AI Team logo 從 AppBar 移到 Drawer 頂部 *@
        @* follow-up #5：左 padding 56px 避開 hamburger float 區（top:8px left:8px + icon ~48px） *@
        <div class="drawer-logo pa-3" style="padding-left:56px">
            <MudText Typo="Typo.h6">AI Team</MudText>
        </div>
        <NavMenu />
        <MudSpacer />
        <div class="pa-2">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                @* Stage 86 子項 6：主題切換改 ThemeToggleButton Interactive component（C# event + IThemeService Scoped 共享 state） *@
                <ThemeToggleButton />
                <LogoutButton />
            </MudStack>
            <MudText Typo="Typo.caption" Class="d-block text-center">@AppVersion</MudText>
        </div>
    </MudDrawer>
    <MudMainContent>
        <div class="pa-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>
