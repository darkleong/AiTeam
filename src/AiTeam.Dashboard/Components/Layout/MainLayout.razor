@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_isDarkMode" IsDarkModeChanged="OnDarkModeChangedAsync" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Default" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="ToggleSidebar" />
        <MudText Typo="Typo.h6" Class="ml-2">AI Team</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudDrawer @bind-Open="_sidebarOpen" Variant="DrawerVariant.Persistent" Elevation="2" ClipMode="DrawerClipMode.Always">
        <NavMenu />
        <MudSpacer />
        <div class="pa-2">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               title="切換主題" OnClick="@(() => OnDarkModeChangedAsync(!_isDarkMode))" />
                <LogoutButton />
            </MudStack>
            <MudText Typo="Typo.caption" Class="d-block text-center">@AppVersion</MudText>
        </div>
    </MudDrawer>
    <MudMainContent>
        <div class="pa-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>
