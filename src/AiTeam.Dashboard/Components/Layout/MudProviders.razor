@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IThemeService Theme
@implements IDisposable

<MudThemeProvider IsDarkMode="@Theme.IsDarkMode" Theme="_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@* Stage 85 子項 1：跨 circuit alert toast subscriber — 訂閱 ReceiveAlertEvent 後 MudSnackbar 彈出 *@
<AlertToastSubscriber />

@code {
    /// <summary>
    /// Stage 86 子項 6：Theme 機制根因修（取代 Stage 83 v4 Bug 9 一半修法）。
    ///
    /// 既有 trade-off（Stage 83 留 Stage 84+）：「Christ 切換 theme 後即時切換 UX 留 Stage 84+（需 MainLayout setDark JS 改 C# event + MudProviders subscribe）」
    /// 真實阻塞：MainLayout 是 Static SSR（mudblazor.md 第一節）→ 無法持 C# event。
    ///
    /// 修法：抽 ThemeToggleButton.razor @rendermode Interactive + 共享 Scoped IThemeService event。
    /// ThemeToggleButton click → IThemeService.SetDarkMode → OnChanged event → MudProviders subscribe → StateHasChanged → MudPaper / MudCard / MudTabs 即時切色（不 reload）。
    ///
    /// MudTheme PaletteDark = Christ 喜歡的深灰色 baseline（VS Code Dark+ 對齊 / 取代既有藍紫色系 #1a1a2e / #16213e / #0f3460）/
    /// PaletteLight = 既有白系沿用。實作驗收期 Christ Chrome MCP 視覺微調 hex / plan v2 結案紀錄段落地。
    /// </summary>
    private readonly MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Background     = "#ffffff",
            BackgroundGray = "#f8f9fa",
            Surface        = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#ffffff",
            TextPrimary    = "#212529",
            TextSecondary  = "#6c757d",
            DrawerText     = "#212529",
            AppbarText     = "#212529",
            Primary        = "#6366f1",
        },
        PaletteDark = new PaletteDark
        {
            Black            = "#0a0a0a",
            Background       = "#1e1e1e",  // 主背景 — VS Code Dark+ baseline
            BackgroundGray   = "#2d2d2d",  // 次背景
            Surface          = "#252525",  // card / paper layer
            DrawerBackground = "#2d2d2d",
            AppbarBackground = "#2d2d2d",
            TextPrimary      = "rgba(255,255,255,0.87)",
            TextSecondary    = "rgba(255,255,255,0.60)",
            DrawerText       = "rgba(255,255,255,0.87)",
            DrawerIcon       = "rgba(255,255,255,0.54)",
            AppbarText       = "rgba(255,255,255,0.87)",
            Primary          = "#818cf8",  // 既有 dark accent 沿用
            ActionDefault    = "rgba(255,255,255,0.54)",
            ActionDisabled   = "rgba(255,255,255,0.26)",
            DividerLight     = "rgba(255,255,255,0.10)",
            Divider          = "rgba(255,255,255,0.15)",
            LinesDefault     = "rgba(255,255,255,0.15)",
            LinesInputs      = "rgba(255,255,255,0.30)",
            TableLines       = "rgba(255,255,255,0.10)",
            TableStriped     = "rgba(255,255,255,0.04)",
            TableHover       = "rgba(255,255,255,0.08)",
        },
    };

    protected override void OnInitialized()
    {
        Theme.OnChanged += OnThemeChanged;
    }

    private async void OnThemeChanged()
    {
        // OnChanged event fire → MudThemeProvider re-render IsDarkMode binding → MudPaper / MudCard 即時切色
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnChanged -= OnThemeChanged;
    }
}
