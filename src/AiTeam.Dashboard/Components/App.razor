<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Team Dashboard</title>
    <base href="/" />
    <script>
        // 立即套用主題，避免首次渲染閃白
        (function(){
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.dataset.theme = t;
        })();

        // appTheme：Dark Mode 管理（localStorage + html[data-theme]）
        window.appTheme = {
            init: function () {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.dataset.theme = t;
                return t === 'dark';
            },
            setDark: function (isDark) {
                var t = isDark ? 'dark' : 'light';
                localStorage.setItem('theme', t);
                document.documentElement.dataset.theme = t;
            }
        };

        // Stage 86 子項 5：Sidebar 兩態切換（hover overlay + click pin）
        //   - hover hamburger → mud-drawer--overlay-mode + mud-drawer--open（drawer 浮出不擠壓 main）
        //   - mouseleave drawer → 300ms 後縮回（hover 緩衝避免閃爍）
        //   - click hamburger → toggle pinned state（pin 模式擠壓 main / 對齊既有 Persistent drawer 行為）
        //   - pinned state 持久化 localStorage `sidebarPinned`
        window.aiteamSidebar = {
            pinned: false,
            hoverTimer: null,

            _getDrawer: function () { return document.querySelector('#main-sidebar'); },
            _getLayout: function () { return document.querySelector('.mud-layout'); },

            init: function () {
                var hamburger = document.querySelector('#sidebar-hamburger');
                var drawer    = window.aiteamSidebar._getDrawer();
                var layout    = window.aiteamSidebar._getLayout();
                if (!hamburger || !drawer || !layout) {
                    requestAnimationFrame(window.aiteamSidebar.init);
                    return;
                }
                // 還原初始 pin state（localStorage / default 不 pinned）
                window.aiteamSidebar.setPinned(localStorage.getItem('sidebarPinned') === '1');

                // hover hamburger → overlay 展開
                hamburger.addEventListener('mouseenter', function () {
                    if (window.aiteamSidebar.pinned) return;
                    clearTimeout(window.aiteamSidebar.hoverTimer);
                    drawer.classList.remove('mud-drawer--initial');
                    drawer.classList.add('mud-drawer--overlay-mode');
                    drawer.classList.add('mud-drawer--open');
                    drawer.classList.remove('mud-drawer--closed');
                });
                // mouseleave drawer → 300ms 後縮
                drawer.addEventListener('mouseleave', function () {
                    if (window.aiteamSidebar.pinned) return;
                    window.aiteamSidebar.hoverTimer = setTimeout(function () {
                        drawer.classList.remove('mud-drawer--open');
                        drawer.classList.add('mud-drawer--closed');
                        drawer.classList.remove('mud-drawer--overlay-mode');
                    }, 300);
                });
                // hover drawer 自己時不縮（取消縮計時器）
                drawer.addEventListener('mouseenter', function () {
                    if (window.aiteamSidebar.pinned) return;
                    clearTimeout(window.aiteamSidebar.hoverTimer);
                });
            },

            toggle: function () {
                window.aiteamSidebar.setPinned(!window.aiteamSidebar.pinned);
            },

            setPinned: function (pinned) {
                var drawer = window.aiteamSidebar._getDrawer();
                var layout = window.aiteamSidebar._getLayout();
                if (!drawer || !layout) return;

                window.aiteamSidebar.pinned = pinned;
                drawer.classList.remove('mud-drawer--initial');
                if (pinned) {
                    drawer.classList.add('mud-drawer--open');
                    drawer.classList.remove('mud-drawer--closed');
                    drawer.classList.remove('mud-drawer--overlay-mode');
                    layout.classList.add('mud-drawer-open-persistent-left');
                } else {
                    drawer.classList.remove('mud-drawer--open');
                    drawer.classList.add('mud-drawer--closed');
                    drawer.classList.remove('mud-drawer--overlay-mode');
                    layout.classList.remove('mud-drawer-open-persistent-left');
                }
                localStorage.setItem('sidebarPinned', pinned ? '1' : '0');
            }
        };

        // 頁面載入後 init（rAF 輪詢等 Blazor 渲染 MudDrawer + hamburger DOM）
        requestAnimationFrame(window.aiteamSidebar.init);
    </script>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet />
</head>

<body>
    @* Routes.razor 包含 Router + CascadingAuthenticationState，並宣告 @rendermode InteractiveServer，
       讓整個應用在同一 circuit 執行，確保 MudProviders 與頁面元件共享 scoped services *@
    <Routes />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
