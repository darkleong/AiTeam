<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Team Dashboard</title>
    <base href="/" />
    <script>
        // 立即套用主題，避免首次渲染閃白
        (function(){
            var t = localStorage.getItem('theme') || 'light';
            document.documentElement.dataset.theme = t;
        })();

        // appTheme：Dark Mode 管理（localStorage + html[data-theme]）
        window.appTheme = {
            init: function () {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.dataset.theme = t;
                return t === 'dark';
            },
            setDark: function (isDark) {
                var t = isDark ? 'dark' : 'light';
                localStorage.setItem('theme', t);
                document.documentElement.dataset.theme = t;
            }
        };

        // aiteamToggleSidebar：透過 CSS class 切換 MudDrawer Persistent 收合狀態
        // MudBlazor Persistent Drawer 使用兩組 class 控制：
        //   1. drawer 本身：mud-drawer--open / mud-drawer--closed（雙 hyphen）
        //   2. .mud-layout：mud-drawer-open-persistent-left（控制 .mud-main-content margin-left）
        window.aiteamToggleSidebar = function () {
            var drawer = document.querySelector('.mud-drawer-persistent');
            var layout = document.querySelector('.mud-layout');
            if (!drawer || !layout) return;
            var isOpen = drawer.classList.contains('mud-drawer--open');
            // 移除 initial class 以啟用動畫
            drawer.classList.remove('mud-drawer--initial');
            if (isOpen) {
                drawer.classList.remove('mud-drawer--open');
                drawer.classList.add('mud-drawer--closed');
                layout.classList.remove('mud-drawer-open-persistent-left');
                localStorage.setItem('sidebarOpen', '0');
            } else {
                drawer.classList.remove('mud-drawer--closed');
                drawer.classList.add('mud-drawer--open');
                layout.classList.add('mud-drawer-open-persistent-left');
                localStorage.setItem('sidebarOpen', '1');
            }
        };

        // 側邊欄初始化：讀取 localStorage 決定初始收合狀態
        // 使用 rAF 輪詢，等 Blazor 渲染 MudDrawer 後再套用（DOMContentLoaded 太早，元素尚未存在）
        (function () {
            if (localStorage.getItem('sidebarOpen') !== '0') return;
            function applySidebarClosed() {
                var drawer = document.querySelector('.mud-drawer-persistent');
                var layout = document.querySelector('.mud-layout');
                if (!drawer || !layout) {
                    requestAnimationFrame(applySidebarClosed);
                    return;
                }
                drawer.classList.remove('mud-drawer--initial');
                drawer.classList.remove('mud-drawer--open');
                drawer.classList.add('mud-drawer--closed');
                layout.classList.remove('mud-drawer-open-persistent-left');
            }
            requestAnimationFrame(applySidebarClosed);
        })();
    </script>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet />
</head>

<body>
    @* Routes.razor 包含 Router + CascadingAuthenticationState，並宣告 @rendermode InteractiveServer，
       讓整個應用在同一 circuit 執行，確保 MudProviders 與頁面元件共享 scoped services *@
    <Routes />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
