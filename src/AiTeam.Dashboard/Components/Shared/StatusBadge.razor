@* 狀態 Badge 組件，顏色對應不同任務/Agent 狀態 *@

<span class="status-badge status-@Status.ToLower()">@GetLabel()</span>

@code {
    [Parameter, EditorRequired]
    public string Status { get; set; } = "";

    private string GetLabel() => Status switch
    {
        "pending"   => "等待中",
        "queued"    => "排隊中",
        "running"   => "執行中",
        "done"      => "完成",
        "failed"    => "失敗",
        "idle"      => "閒置",
        "error"     => "錯誤",
        "revision"  => "修正中",
        "reviewing" => "審核中",
        "cancelled" => "已取消",
        "skipped"   => "略過",
        _ => Status
    };
}
